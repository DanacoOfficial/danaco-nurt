# Module:           .gitattributes
# Responsibility:   Attributes of the files of the repository: line endings and treatment of generated files.
# Dependencies:     none
# Author:           Danaco Official
# Version:          0.1.1, 2026-11-27
# License:          see the LICENSE file or https://www.danaco-group.pl

# Text files are stored with LF line endings and checked out with LF on every
# platform, so that formatting checks and golden files are identical everywhere.
* text=auto eol=lf

# Windows scripts keep CRLF line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Language hints for repository statistics and diffs.
*.rs text diff=rust
*.toml text
*.md text diff=markdown
*.json text
*.nurt text
Cargo.lock text linguist-generated=true

# Binary files are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.bz2 binary
*.xz binary
*.zst binary
*.lz4 binary
*.7z binary
*.tar binary
*.sqlite binary
*.db binary
*.cbor binary
*.wasm binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.lib binary

# Test data with fixed bytes (encodings, line endings, binary formats) is kept
# exactly as committed.
**/testdata/** -text
**/fixtures/** -text

