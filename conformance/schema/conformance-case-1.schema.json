{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nurt.danaco-group.pl/schema/nurt-conformance-case-1.schema.json",
  "title": "nurt-conformance-case/1",
  "description": "Conformance case (case.toml in its JSON form) or collection of cases (*.cases.toml, *.cases.json).",
  "if": { "type": "object", "required": ["format"] },
  "then": { "$ref": "#/$defs/collection" },
  "else": { "$ref": "#/$defs/case" },
  "$defs": {
    "collection": {
      "type": "object",
      "required": ["format", "case"],
      "additionalProperties": false,
      "properties": {
        "format": { "const": "nurt-conformance-cases/1" },
        "case": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
      }
    },
    "kind": {
      "enum": ["golden", "bind", "error", "exec", "journal", "correction", "parity", "binding"]
    },
    "class": {
      "type": "string",
      "pattern": "^(mandatory|optional:[a-z0-9][a-z0-9_.-]*)$"
    },
    "condition": {
      "type": "string",
      "pattern": "^(os:(linux|macos|windows|unix)|feature:[a-z0-9][a-z0-9_.-]*|fixture:(http|second-volume))$"
    },
    "variant": { "enum": ["a", "b", "c"] },
    "data": {
      "description": "File name relative to the case directory, or the value itself.",
      "type": ["string", "object"]
    },
    "pointer": { "type": "string", "pattern": "^(/([^~]|~[01])*)*$" },
    "header": {
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
        "kind": { "$ref": "#/$defs/kind" },
        "class": { "$ref": "#/$defs/class", "default": "mandatory" },
        "language": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$", "default": "1.0" },
        "requires": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "summary": { "type": "string", "minLength": 1 },
        "variant": { "$ref": "#/$defs/variant", "default": "a" },
        "code": { "type": "string", "pattern": "^E_[A-Z0-9_]+$" },
        "volatile": { "type": "array", "items": { "type": "string", "pattern": "^(/([^~]|~[01])*)*$" } },
        "config": { "type": "string", "minLength": 1 },
        "fs_before": { "$ref": "#/$defs/data" },
        "second_volume_before": {
          "description": "Initial state of the directory of the case on the second volume; requires fixture:second-volume.",
          "$ref": "#/$defs/data"
        },
        "http_files": {
          "description": "Snapshot whose files the local HTTP server serves below /files/; requires fixture:http.",
          "$ref": "#/$defs/data"
        },
        "step": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      },
      "required": ["id", "kind", "summary"],
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "error" } }, "required": ["kind"] },
          "then": { "required": ["code"] }
        },
        {
          "if": { "required": ["second_volume_before"] },
          "then": { "$ref": "#/$defs/needsSecondVolume" }
        },
        {
          "if": { "required": ["http_files"] },
          "then": {
            "required": ["requires"],
            "properties": { "requires": { "contains": { "const": "fixture:http" } } }
          }
        }
      ]
    },
    "needsSecondVolume": {
      "required": ["requires"],
      "properties": { "requires": { "contains": { "const": "fixture:second-volume" } } }
    },
    "stepMembers": {
      "properties": {
        "method": { "type": "string", "minLength": 1, "default": "run" },
        "program": { "type": "string" },
        "program_file": { "type": "string", "minLength": 1 },
        "variant": { "$ref": "#/$defs/variant" },
        "options": { "$ref": "#/$defs/data" },
        "params": { "$ref": "#/$defs/data" },
        "expect": { "$ref": "#/$defs/data" },
        "expect_at": { "$ref": "#/$defs/pointer" },
        "match": { "enum": ["subset", "exact", "tree"], "default": "subset" },
        "expect_error": { "type": "integer" },
        "validate": {
          "enum": ["ast", "bound", "report", "request", "config", "catalog", "value", "tool", "metaschema"]
        },
        "fs_after": { "$ref": "#/$defs/data" },
        "absent": {
          "description": "Pointer patterns into the result at which no value may exist; * matches any member or index.",
          "type": "array",
          "items": { "type": "string", "pattern": "^(/([^~]|~[01])*)+$" }
        },
        "events": {
          "description": "Expected events nurt/event of the call; each is compared with a received event as a subset.",
          "type": "array",
          "items": { "type": "object" }
        },
        "events_match": { "enum": ["ordered", "exact"], "default": "ordered" },
        "second_volume_after": {
          "description": "Expected state of the directory of the case on the second volume after the call.",
          "$ref": "#/$defs/data"
        },
        "setup_only": {
          "description": "Marks a last step that states no expectation because it only prepares or cleans up the state.",
          "type": "boolean",
          "default": false
        }
      },
      "dependentRequired": { "events_match": ["events"] }
    },
    "step": {
      "type": "object",
      "$ref": "#/$defs/stepMembers",
      "unevaluatedProperties": false,
      "not": { "required": ["program", "program_file"] }
    },
    "case": { "$ref": "#/$defs/entry" },
    "entry": {
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/header" }, { "$ref": "#/$defs/stepMembers" }],
      "unevaluatedProperties": false,
      "not": { "required": ["program", "program_file"] },
      "dependentSchemas": {
        "step": {
          "not": {
            "anyOf": [
              { "required": ["method"] },
              { "required": ["program"] },
              { "required": ["program_file"] },
              { "required": ["params"] },
              { "required": ["expect"] },
              { "required": ["expect_error"] },
              { "required": ["fs_after"] },
              { "required": ["absent"] },
              { "required": ["events"] },
              { "required": ["second_volume_after"] },
              { "required": ["setup_only"] }
            ]
          }
        }
      }
    }
  }
}
