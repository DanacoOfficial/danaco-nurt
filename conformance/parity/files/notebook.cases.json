{
  "format": "nurt-conformance-cases/1",
  "case": [
    {
      "id": "parity/files/notebook/cells-outline",
      "kind": "parity",
      "summary": "Lists the cells of a notebook.",
      "fs_before": {
        "entries": [
          {
            "path": "a.ipynb",
            "type": "file",
            "content_utf8": "{\n \"cells\": [\n  {\n   \"cell_type\": \"markdown\",\n   \"id\": \"m1\",\n   \"metadata\": {},\n   \"source\": [\n    \"# Title\"\n   ]\n  },\n  {\n   \"cell_type\": \"code\",\n   \"id\": \"c1\",\n   \"metadata\": {},\n   \"execution_count\": 1,\n   \"source\": [\n    \"print(1)\"\n   ],\n   \"outputs\": [\n    {\n     \"output_type\": \"stream\",\n     \"name\": \"stdout\",\n     \"text\": [\n      \"1\\n\"\n     ]\n    }\n   ]\n  }\n ],\n \"metadata\": {},\n \"nbformat\": 4,\n \"nbformat_minor\": 5\n}\n"
          }
        ]
      },
      "program": "notebook.cells \"a.ipynb\"",
      "expect": {
        "report": {
          "status": "ok",
          "records": {
            "type": "cell",
            "matched": 2
          }
        }
      },
      "fs_after": "unchanged"
    },
    {
      "id": "parity/files/notebook/cells-code-only",
