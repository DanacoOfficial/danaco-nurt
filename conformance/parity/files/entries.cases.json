{
  "format": "nurt-conformance-cases/1",
  "case": [
    {
      "id": "parity/files/entries/remove-file",
      "kind": "parity",
      "summary": "Removes a file.",
      "fs_before": {
        "entries": [
          {
            "path": "a.txt",
            "type": "file",
            "content_utf8": "a\n"
          },
          {
            "path": "dir/b.txt",
            "type": "file",
            "content_utf8": "b\n"
          },
          {
            "path": "dir/sub/c.txt",
            "type": "file",
            "content_utf8": "c\n"
          },
          {
            "path": "keep.txt",
            "type": "file",
            "content_utf8": "k\n"
          }
        ]
      },
      "program": "remove \"a.txt\"",
      "expect": {
        "report": {
          "status": "ok",
          "kind": "remove",
          "summary": {
            "files_deleted": 1
          },
          "changes": [
            {
              "path": "${base}/a.txt",
              "action": "delete"
            }
          ]
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "dir/b.txt",
            "type": "file",
            "content_utf8": "b\n"
          },
          {
            "path": "dir/sub/c.txt",
            "type": "file",
            "content_utf8": "c\n"
          },
          {
            "path": "keep.txt",
            "type": "file",
            "content_utf8": "k\n"
          }
        ]
      }
    },
    {
      "id": "parity/files/entries/remove-tree",
      "kind": "parity",
      "summary": "Removes a directory tree as one target.",
      "fs_before": {
        "entries": [
