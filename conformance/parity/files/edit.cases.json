      "program": "replace \"1}\" \"1\" in: [\"c.json\"]",
      "expect": {
        "report": {
          "status": "failed",
          "error": {
            "code": "E_DOC_PARSE"
          }
        }
      },
      "fs_after": "unchanged"
    },
    {
      "id": "parity/files/edit/replace-whitespace-normalize",
      "kind": "parity",
      "summary": "Matches across different runs of white space by default.",
      "fs_before": {
        "entries": [
          {
            "path": "s.txt",
            "type": "file",
            "content_utf8": "if  (x)   {\n"
          }
        ]
      },
      "program": "replace \"if (x) {\" \"if (y) {\" in: [\"s.txt\"]",
      "expect": {
        "report": {
          "status": "ok"
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "s.txt",
            "type": "file",
            "content_utf8": "if (y) {\n"
          }
        ]
      }
    },
    {
      "id": "parity/files/edit/replace-whitespace-exact",
      "kind": "parity",
      "summary": "Exact white space does not match different spacing.",
      "fs_before": {
        "entries": [
          {
            "path": "s.txt",
            "type": "file",
            "content_utf8": "if  (x)\n"
          }
        ]
      },
      "program": "replace \"if (x)\" \"if (y)\" in: [\"s.txt\"] whitespace: exact",
