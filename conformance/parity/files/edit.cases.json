        ]
      },
      "program": "replace \"Brno\" \"Košice\" in: [\"l.txt\"]",
      "expect": {
        "report": {
          "status": "ok",
          "notable": [
            {
              "code": "encoding_preserved"
            }
          ]
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "l.txt",
            "type": "file",
            "content_base64": "S2+aaWNlII5pbGluYQo="
          }
        ]
      }
    },
    {
      "id": "parity/files/edit/replace-keeps-utf16",
      "kind": "parity",
      "summary": "A replacement keeps the UTF-16 encoding and byte order mark.",
      "fs_before": {
        "entries": [
          {
            "path": "u.txt",
            "type": "file",
            "content_base64": "//5hAGwAcABoAGEACgA="
          }
        ]
      },
      "program": "replace \"alpha\" \"beta\" in: [\"u.txt\"]",
      "expect": {
        "report": {
          "status": "ok"
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "u.txt",
            "type": "file",
            "content_base64": "//5iAGUAdABhAAoA"
          }
        ]
      }
    },
    {
      "id": "parity/files/edit/replace-unrepresentable",
      "kind": "parity",
      "summary": "A character the encoding of the file cannot hold fails and changes nothing.",
      "fs_before": {
        "entries": [
          {
            "path": "l.txt",
            "type": "file",
            "content_base64": "YQo="
          }
        ]
      },
      "program": "replace \"a\" \"日本\" in: [\"l.txt\"]",
      "expect": {
        "report": {
          "status": "failed",
          "error": {
            "code": "E_ENCODING"
          }
        }
      },
      "fs_after": "unchanged"
    },
    {
      "id": "parity/files/edit/replace-binary-skipped",
      "kind": "parity",
      "summary": "Binary files are skipped by a replacement in a directory.",
      "fs_before": {
        "entries": [
          {
            "path": "t.txt",
            "type": "file",
            "content_utf8": "x\n"
          },
          {
            "path": "b.bin",
            "type": "file",
            "content_base64": "AHgA"
          }
        ]
      },
      "program": "replace \"x\" \"y\" in: [\".\"]",
      "expect": {
        "report": {
          "status": "ok",
          "notable": [
            {
              "code": "binary_skipped",
              "count": 1
            }
          ]
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "t.txt",
            "type": "file",
            "content_utf8": "y\n"
          },
          {
            "path": "b.bin",
            "type": "file",
            "content_base64": "AHgA"
          }
        ]
      }
    },
    {
      "id": "parity/files/edit/replace-breaks-json",
      "kind": "parity",
      "summary": "A replacement that breaks a JSON document is rejected.",
      "fs_before": {
        "entries": [
          {
            "path": "c.json",
            "type": "file",
            "content_utf8": "{\"a\": 1}\n"
          }
