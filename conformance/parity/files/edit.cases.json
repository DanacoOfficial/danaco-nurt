{
  "format": "nurt-conformance-cases/1",
  "case": [
    {
      "id": "parity/files/edit/replace-all",
      "kind": "parity",
      "summary": "Replaces every occurrence in a file.",
      "fs_before": {
        "entries": [
          {
            "path": "a.go",
            "type": "file",
            "content_utf8": "package a\n\nfunc oldName() {}\n\nfunc b() { oldName() }\n"
          }
        ]
      },
      "program": "replace \"oldName\" \"newName\" in: [\"a.go\"]",
      "expect": {
        "report": {
          "status": "ok",
          "kind": "replace",
          "summary": {
            "files_modified": 1,
            "replacements": 2
          }
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "a.go",
            "type": "file",
            "content_utf8": "package a\n\nfunc newName() {}\n\nfunc b() { newName() }\n"
          }
        ]
      }
    },
    {
      "id": "parity/files/edit/replace-first",
      "kind": "parity",
      "summary": "Replaces the first occurrence only.",
      "fs_before": {
        "entries": [
          {
            "path": "a.go",
            "type": "file",
            "content_utf8": "package a\n\nfunc oldName() {}\n\nfunc b() { oldName() }\n"
          }
        ]
      },
      "program": "replace \"oldName\" \"newName\" in: [\"a.go\"] occurrence: 1",
      "expect": {
        "report": {
          "status": "ok",
          "summary": {
            "replacements": 1
          }
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "a.go",
            "type": "file",
            "content_utf8": "package a\n\nfunc newName() {}\n\nfunc b() { oldName() }\n"
          }
        ]
      }
    },
    {
      "id": "parity/files/edit/replace-second",
      "kind": "parity",
      "summary": "Replaces the second occurrence only.",
      "fs_before": {
        "entries": [
          {
            "path": "a.go",
            "type": "file",
            "content_utf8": "package a\n\nfunc oldName() {}\n\nfunc b() { oldName() }\n"
          }
        ]
      },
      "program": "replace \"oldName\" \"newName\" in: [\"a.go\"] occurrence: 2",
      "expect": {
        "report": {
          "status": "ok"
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "a.go",
            "type": "file",
            "content_utf8": "package a\n\nfunc oldName() {}\n\nfunc b() { newName() }\n"
          }
        ]
      }
    },
    {
      "id": "parity/files/edit/replace-regex-group",
      "kind": "parity",
      "summary": "Replaces with a capture group.",
      "fs_before": {
        "entries": [
          {
            "path": "v.txt",
            "type": "file",
            "content_utf8": "version=1.2.3\n"
          }
        ]
      },
      "program": "replace /version=(\\d+)\\.(\\d+)\\.(\\d+)/ \"version=$1.$2.4\" in: [\"v.txt\"]",
      "expect": {
        "report": {
          "status": "ok"
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "v.txt",
            "type": "file",
            "content_utf8": "version=1.2.4\n"
          }
        ]
      }
    },
    {
      "id": "parity/files/edit/replace-literal-dollar",
      "kind": "parity",
      "summary": "A replacement without groups keeps a dollar sign when templates are off.",
      "fs_before": {
        "entries": [
          {
            "path": "p.txt",
            "type": "file",
            "content_utf8": "price\n"
          }
        ]
      },
      "program": "replace \"price\" \"$5\" in: [\"p.txt\"] template: false",
      "expect": {
        "report": {
          "status": "ok"
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "p.txt",
            "type": "file",
            "content_utf8": "$5\n"
          }
        ]
      }
    },
    {
      "id": "parity/files/edit/replace-expect-holds",
      "kind": "parity",
      "summary": "A replacement with the expected count applies.",
      "fs_before": {
        "entries": [
          {
            "path": "a.go",
            "type": "file",
            "content_utf8": "package a\n\nfunc oldName() {}\n\nfunc b() { oldName() }\n"
          }
        ]
      },
      "program": "replace \"oldName\" \"newName\" in: [\"a.go\"] expect: 2",
      "expect": {
        "report": {
          "status": "ok"
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "a.go",
            "type": "file",
            "content_utf8": "package a\n\nfunc newName() {}\n\nfunc b() { newName() }\n"
          }
        ]
      }
    },
    {
      "id": "parity/files/edit/replace-expect-fails",
      "kind": "parity",
      "summary": "A replacement with another count than expected changes nothing.",
      "fs_before": {
        "entries": [
          {
            "path": "a.go",
            "type": "file",
            "content_utf8": "package a\n\nfunc oldName() {}\n\nfunc b() { oldName() }\n"
          }
        ]
      },
      "program": "replace \"oldName\" \"newName\" in: [\"a.go\"] expect: 3",
      "expect": {
        "report": {
          "status": "failed"
        }
      },
      "fs_after": "unchanged"
    },
    {
      "id": "parity/files/edit/replace-no-match-skip",
      "kind": "parity",
      "summary": "A replacement without a match succeeds and changes nothing by default.",
      "fs_before": {
        "entries": [
          {
            "path": "a.go",
            "type": "file",
            "content_utf8": "package a\n\nfunc oldName() {}\n\nfunc b() { oldName() }\n"
          }
        ]
      },
      "program": "replace \"absent\" \"x\" in: [\"a.go\"]",
      "expect": {
        "report": {
          "status": "ok",
          "notable": [
            {
              "code": "nothing_matched"
            }
          ]
        }
      },
      "fs_after": "unchanged"
    },
    {
      "id": "parity/files/edit/replace-no-match-error",
      "kind": "parity",
      "summary": "A replacement without a match fails when asked.",
      "fs_before": {
        "entries": [
          {
            "path": "a.go",
            "type": "file",
            "content_utf8": "package a\n\nfunc oldName() {}\n\nfunc b() { oldName() }\n"
          }
        ]
      },
      "program": "replace \"absent\" \"x\" in: [\"a.go\"] on_missing: error",
      "expect": {
        "report": {
          "status": "failed",
          "error": {
            "code": "E_NO_MATCH"
          }
        }
      },
      "fs_after": "unchanged"
    },
    {
      "id": "parity/files/edit/replace-whole-word",
      "kind": "parity",
      "summary": "Replaces whole words only.",
      "fs_before": {
        "entries": [
          {
            "path": "w.txt",
            "type": "file",
            "content_utf8": "cat catalog cat\n"
          }
        ]
      },
      "program": "replace \"cat\" \"dog\" in: [\"w.txt\"] whole_word: true",
      "expect": {
        "report": {
          "status": "ok"
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "w.txt",
            "type": "file",
            "content_utf8": "dog catalog dog\n"
          }
        ]
      }
    },
    {
      "id": "parity/files/edit/replace-case-insensitive",
      "kind": "parity",
      "summary": "Replaces without letter case when asked.",
      "fs_before": {
        "entries": [
          {
            "path": "w.txt",
            "type": "file",
            "content_utf8": "Foo foo FOO\n"
          }
        ]
      },
      "program": "replace \"foo\" \"bar\" in: [\"w.txt\"] case_sensitive: false",
      "expect": {
        "report": {
          "status": "ok"
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "w.txt",
            "type": "file",
            "content_utf8": "bar bar bar\n"
          }
        ]
      }
    },
    {
      "id": "parity/files/edit/replace-in-directory",
      "kind": "parity",
      "summary": "Replaces in every file of a directory matching a glob.",
      "fs_before": {
        "entries": [
          {
            "path": "a.txt",
            "type": "file",
            "content_utf8": "x = 1\n"
          },
          {
            "path": "b.txt",
            "type": "file",
            "content_utf8": "x = 2\n"
          },
          {
            "path": "c.md",
            "type": "file",
            "content_utf8": "x = 3\n"
          }
        ]
      },
      "program": "replace \"x =\" \"y =\" in: [\".\"] glob: \"*.txt\"",
      "expect": {
        "report": {
          "status": "ok",
          "summary": {
            "files_modified": 2
          }
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "a.txt",
            "type": "file",
            "content_utf8": "y = 1\n"
          },
          {
            "path": "b.txt",
            "type": "file",
            "content_utf8": "y = 2\n"
          },
          {
            "path": "c.md",
            "type": "file",
            "content_utf8": "x = 3\n"
          }
        ]
      }
    },
    {
      "id": "parity/files/edit/replace-found-matches",
      "kind": "parity",
      "summary": "Replaces the matches found by a search.",
      "fs_before": {
        "entries": [
          {
            "path": "a.go",
            "type": "file",
            "content_utf8": "package a\n\nfunc oldName() {}\n\nfunc b() { oldName() }\n"
          }
        ]
      },
      "program": "search \"oldName\" \".\" |> replace \"newName\"",
      "expect": {
        "report": {
          "status": "ok",
          "summary": {
            "replacements": 2
          }
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "a.go",
            "type": "file",
            "content_utf8": "package a\n\nfunc newName() {}\n\nfunc b() { newName() }\n"
          }
        ]
      }
    },
    {
      "id": "parity/files/edit/replace-assert-before",
      "kind": "parity",
      "summary": "An assertion on the number of files before the change holds and the change applies.",
      "fs_before": {
        "entries": [
          {
            "path": "a.go",
            "type": "file",
            "content_utf8": "package a\n\nfunc oldName() {}\n\nfunc b() { oldName() }\n"
          }
        ]
      },
      "program": "search \"oldName\" \".\" |> assert paths: 1 |> replace \"newName\"",
      "expect": {
        "report": {
          "status": "ok"
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "a.go",
            "type": "file",
            "content_utf8": "package a\n\nfunc newName() {}\n\nfunc b() { newName() }\n"
          }
        ]
      }
    },
    {
      "id": "parity/files/edit/replace-assert-fails",
      "kind": "parity",
      "summary": "A failed assertion before the change changes nothing.",
      "fs_before": {
        "entries": [
          {
            "path": "a.go",
            "type": "file",
            "content_utf8": "package a\n\nfunc oldName() {}\n\nfunc b() { oldName() }\n"
          }
        ]
      },
      "program": "search \"oldName\" \".\" |> assert paths: 2 |> replace \"newName\"",
      "expect": {
        "report": {
          "status": "failed",
          "error": {
            "code": "E_ASSERT",
            "stage": "3"
          }
        }
      },
      "fs_after": "unchanged"
    },
    {
      "id": "parity/files/edit/replace-keeps-crlf",
      "kind": "parity",
      "summary": "A replacement keeps CRLF line endings.",
      "fs_before": {
        "entries": [
          {
            "path": "w.txt",
            "type": "file",
            "content_utf8": "old\r\nkeep\r\n"
          }
        ]
      },
      "program": "replace \"old\" \"new\" in: [\"w.txt\"]",
      "expect": {
        "report": {
          "status": "ok"
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "w.txt",
            "type": "file",
            "content_utf8": "new\r\nkeep\r\n"
          }
        ]
      }
    },
    {
      "id": "parity/files/edit/replace-keeps-cp1250",
      "kind": "parity",
      "summary": "A replacement keeps the Windows-1250 encoding.",
      "fs_before": {
        "entries": [
          {
            "path": "l.txt",
            "type": "file",
            "content_base64": "QnJubyCOaWxpbmEK"
