        "entries": [
          {
            "path": "e.go",
            "type": "file",
            "content_utf8": "line1\nline2 oldName(\nline3\nline4\nline5\n"
          }
        ]
      },
      "program": "edit \"e.go\" changes: [{replace: \"oldName(\", with: \"newName(\"}, {replace: \"absent\", with: \"x\"}] on_missing: error",
      "expect": {
