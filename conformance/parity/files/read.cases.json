    {
      "id": "parity/files/read/whole-file",
      "kind": "parity",
      "summary": "Reads a whole UTF-8 file.",
      "fs_before": {
        "entries": [
          {
            "path": "a.txt",
            "type": "file",
            "content_utf8": "one\ntwo\nthree\nfour\nfive\n"
          }
        ]
      },
      "program": "read \"a.txt\"",
      "expect": {
        "report": {
          "status": "ok",
          "kind": "read",
          "records": {
            "type": "content",
            "rows": [
              {
                "kind": "content",
                "fields": {
                  "path": {
                    "t": "path",
                    "v": "${base}/a.txt"
                  },
                  "text": {
                    "t": "text",
                    "v": "one\ntwo\nthree\nfour\nfive\n"
                  },
                  "lines": {
                    "t": "int",
                    "v": 5
                  }
                }
              }
            ],
            "matched": 1
          }
        }
      },
      "fs_after": "unchanged"
    },
