    {
      "id": "parity/files/write/if-match-stale",
      "kind": "parity",
      "summary": "A write with an outdated entity tag fails and changes nothing.",
      "fs_before": {
        "entries": [
          {
            "path": "keep.txt",
            "type": "file",
            "content_utf8": "keep\n"
          }
        ]
      },
      "step": [
        {
          "program": "read \"keep.txt\"",
          "expect": {
            "report": {
              "status": "ok"
            }
          }
        },
        {
          "program": "write \"keep.txt\" \"changed\\n\" mode: overwrite",
          "expect": {
            "report": {
              "status": "ok"
            }
          }
        },
        {
          "program": "write \"keep.txt\" \"late\\n\" mode: overwrite if_match: \"${step1/report/records/rows/0/fields/etag/v}\"",
          "expect": {
            "report": {
              "status": "failed",
              "error": {
                "code": "E_STALE"
              }
            }
          },
          "fs_after": {
            "entries": [
              {
                "path": "keep.txt",
                "type": "file",
                "content_utf8": "changed\n"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "parity/files/write/file-mode",
      "kind": "parity",
