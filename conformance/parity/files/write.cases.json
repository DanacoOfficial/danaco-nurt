    {
      "id": "parity/files/write/emptied-is-notable",
      "kind": "parity",
      "summary": "Emptying a file is an unusual effect.",
      "fs_before": {
        "entries": [
          {
            "path": "keep.txt",
            "type": "file",
            "content_utf8": "keep\n"
          }
        ]
      },
      "program": "write \"keep.txt\" \"\" mode: overwrite",
      "expect": {
        "report": {
          "status": "ok",
          "notable": [
            {
              "code": "file_emptied",
              "severity": "warning",
              "path": "${base}/keep.txt"
            },
            {
              "code": "overwrote_existing"
            }
          ]
        }
      },
      "fs_after": {
        "entries": [
