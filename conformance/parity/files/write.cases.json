{
  "format": "nurt-conformance-cases/1",
  "case": [
    {
      "id": "parity/files/write/create",
      "kind": "parity",
      "summary": "Creates a new file with the text.",
      "fs_before": {
        "entries": [
          {
            "path": "keep.txt",
            "type": "file",
            "content_utf8": "keep\n"
          }
        ]
      },
      "program": "write \"new.txt\" \"hello\\n\" mode: create",
      "expect": {
        "report": {
          "status": "ok",
          "kind": "write",
          "summary": {
            "files_created": 1
          },
          "changes": [
            {
              "path": "${base}/new.txt",
              "action": "create"
            }
          ]
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "keep.txt",
            "type": "file",
            "content_utf8": "keep\n"
          },
          {
            "path": "new.txt",
            "type": "file",
            "content_utf8": "hello\n"
          }
        ]
      }
    },
    {
      "id": "parity/files/write/create-existing",
      "kind": "parity",
      "summary": "Creating an existing file fails and changes nothing.",
      "fs_before": {
        "entries": [
          {
            "path": "keep.txt",
            "type": "file",
            "content_utf8": "keep\n"
          }
        ]
      },
      "program": "write \"keep.txt\" \"x\" mode: create",
      "expect": {
        "report": {
          "status": "failed",
          "error": {
            "code": "E_EXISTS"
          }
        }
      },
      "fs_after": "unchanged"
    },
    {
      "id": "parity/files/write/create-parents",
      "kind": "parity",
      "summary": "Creates missing parent directories.",
      "fs_before": {
        "entries": [
          {
            "path": "keep.txt",
            "type": "file",
            "content_utf8": "keep\n"
          }
        ]
      },
      "program": "write \"a/b/c.txt\" \"x\\n\" mode: create",
      "expect": {
        "report": {
          "status": "ok"
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "keep.txt",
            "type": "file",
            "content_utf8": "keep\n"
          },
          {
            "path": "a/b/c.txt",
            "type": "file",
            "content_utf8": "x\n"
          }
        ]
      }
    },
    {
      "id": "parity/files/write/create-without-parents",
      "kind": "parity",
      "summary": "Fails without parents when parents is false.",
      "fs_before": {
        "entries": [
          {
            "path": "keep.txt",
            "type": "file",
            "content_utf8": "keep\n"
          }
        ]
      },
      "program": "write \"a/b/c.txt\" \"x\\n\" mode: create parents: false",
      "expect": {
        "report": {
          "status": "failed",
          "error": {
            "code": "E_NOT_FOUND"
          }
        }
      },
      "fs_after": "unchanged"
    },
    {
      "id": "parity/files/write/overwrite",
      "kind": "parity",
      "summary": "Replaces the content of a file.",
      "fs_before": {
        "entries": [
          {
            "path": "keep.txt",
            "type": "file",
            "content_utf8": "keep\n"
          }
        ]
      },
      "program": "write \"keep.txt\" \"new\\n\" mode: overwrite",
      "expect": {
        "report": {
          "status": "ok",
          "summary": {
            "files_modified": 1
          },
          "notable": [
            {
              "code": "overwrote_existing"
            }
          ]
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "keep.txt",
            "type": "file",
            "content_utf8": "new\n"
          }
        ]
      }
    },
