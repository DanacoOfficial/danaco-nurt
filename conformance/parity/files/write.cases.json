          "status": "ok"
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "keep.txt",
            "type": "file",
            "content_utf8": "keep\n"
          },
          {
            "path": "run.sh",
            "type": "file",
            "content_utf8": "#!/bin/sh\n",
            "mode": "0755"
          }
        ]
      }
    },
    {
      "id": "parity/files/write/preview",
      "kind": "parity",
      "summary": "A preview of a write changes nothing.",
      "fs_before": {
        "entries": [
          {
            "path": "keep.txt",
            "type": "file",
            "content_utf8": "keep\n"
          }
        ]
      },
      "program": "write \"new.txt\" \"x\\n\" mode: create",
      "options": {
        "preview": true
      },
      "expect": {
        "report": {
          "status": "planned",
