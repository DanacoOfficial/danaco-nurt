    {
      "id": "parity/files/write/keeps-legacy-encoding",
      "kind": "parity",
      "summary": "Overwriting a Windows-1250 file keeps its encoding.",
      "fs_before": {
        "entries": [
          {
            "path": "l.txt",
            "type": "file",
            "content_base64": "jmlsaW5hCg=="
          }
        ]
      },
      "program": "write \"l.txt\" \"Šala\\n\" mode: overwrite",
      "expect": {
        "report": {
          "status": "ok",
          "notable": [
            {
              "code": "encoding_preserved"
            },
            {
              "code": "overwrote_existing"
            }
          ]
        }
      },
      "fs_after": {
        "entries": [
          {
            "path": "l.txt",
            "type": "file",
            "content_base64": "imFsYQo="
          }
        ]
      }
    },
