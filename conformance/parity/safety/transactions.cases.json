{
  "format": "nurt-conformance-cases/1",
  "case": [
    {
      "id": "parity/safety/transactions/edit-all-or-nothing",
      "kind": "parity",
      "summary": "An edit whose second change fails changes nothing.",
      "fs_before": {
        "entries": [
          {
            "path": "a.txt",
            "type": "file",
            "content_utf8": "alpha\nbeta\n"
          },
          {
            "path": "b.txt",
            "type": "file",
            "content_utf8": "bravo\n"
          },
          {
            "path": "dir/c.txt",
            "type": "file",
            "content_utf8": "charlie\n"
          },
          {
            "path": "dir/sub/d.txt",
            "type": "file",
            "content_utf8": "delta\n"
          },
          {
            "path": "c.json",
            "type": "file",
            "content_utf8": "{\n  \"name\": \"app\",\n  \"version\": \"1.0.0\"\n}\n"
          },
          {
            "path": "w.txt",
            "type": "file",
            "content_utf8": "one\r\ntwo\r\n"
          }
        ]
      },
      "program": "edit \"a.txt\" changes: [{replace: \"alpha\", with: \"A\"}, {replace: \"absent\", with: \"B\"}] on_missing: error",
      "expect": {
        "report": {
          "status": "failed",
          "error": {
            "code": "E_NO_MATCH"
          }
        }
      },
      "fs_after": "unchanged"
    },
