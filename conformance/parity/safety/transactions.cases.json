    {
      "id": "parity/safety/transactions/stale-read",
      "kind": "parity",
      "summary": "A file changed between the read and the change is not changed again.",
      "fs_before": {
        "entries": [
          {
            "path": "a.txt",
            "type": "file",
            "content_utf8": "alpha\nbeta\n"
          },
          {
            "path": "b.txt",
            "type": "file",
            "content_utf8": "bravo\n"
          },
          {
            "path": "dir/c.txt",
            "type": "file",
            "content_utf8": "charlie\n"
          },
          {
            "path": "dir/sub/d.txt",
            "type": "file",
            "content_utf8": "delta\n"
          },
          {
            "path": "c.json",
            "type": "file",
            "content_utf8": "{\n  \"name\": \"app\",\n  \"version\": \"1.0.0\"\n}\n"
          },
          {
            "path": "w.txt",
            "type": "file",
            "content_utf8": "one\r\ntwo\r\n"
          }
        ]
      },
      "step": [
        {
          "program": "read \"a.txt\"",
          "expect": {
            "report": {
              "status": "ok"
            }
          }
        },
        {
          "program": "write \"a.txt\" \"external\\n\" mode: overwrite",
          "expect": {
            "report": {
              "status": "ok"
            }
          }
        },
        {
          "program": "replace \"alpha\" \"A\" in: [\"a.txt\"] if_match: \"${step1/report/records/rows/0/fields/etag/v}\"",
          "expect": {
            "report": {
              "status": "failed",
              "error": {
                "code": "E_STALE"
              }
            }
          },
          "fs_after": {
            "entries": [
              {
                "path": "a.txt",
                "type": "file",
                "content_utf8": "external\n"
              },
              {
                "path": "b.txt",
                "type": "file",
                "content_utf8": "bravo\n"
              },
              {
                "path": "dir/c.txt",
                "type": "file",
                "content_utf8": "charlie\n"
              },
