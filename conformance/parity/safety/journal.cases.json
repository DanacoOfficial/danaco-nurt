{
  "format": "nurt-conformance-cases/1",
  "case": [
    {
      "id": "parity/safety/journal/undo-file",
      "kind": "parity",
      "class": "optional:journal",
      "summary": "Undo of one file restores only that file.",
      "fs_before": {
        "entries": [
          {
            "path": "a.txt",
            "type": "file",
            "content_utf8": "alpha\nbeta\n"
          },
          {
            "path": "b.txt",
            "type": "file",
            "content_utf8": "bravo\n"
          },
          {
            "path": "dir/c.txt",
            "type": "file",
            "content_utf8": "charlie\n"
          },
          {
            "path": "dir/sub/d.txt",
            "type": "file",
            "content_utf8": "delta\n"
          },
          {
            "path": "c.json",
            "type": "file",
            "content_utf8": "{\n  \"name\": \"app\",\n  \"version\": \"1.0.0\"\n}\n"
          },
          {
            "path": "w.txt",
            "type": "file",
            "content_utf8": "one\r\ntwo\r\n"
          }
        ]
      },
      "step": [
        {
          "program": "replace \"a\" \"A\" in: [\"a.txt\", \"b.txt\"]",
          "expect": {
            "report": {
              "status": "ok"
            }
          }
        },
        {
          "program": "undo file: \"a.txt\"",
          "expect": {
            "report": {
              "status": "ok"
            }
          },
          "fs_after": {
            "entries": [
              {
                "path": "a.txt",
                "type": "file",
                "content_utf8": "alpha\nbeta\n"
              },
              {
                "path": "b.txt",
                "type": "file",
                "content_utf8": "brAvo\n"
              },
              {
                "path": "dir/c.txt",
                "type": "file",
                "content_utf8": "charlie\n"
              },
              {
                "path": "dir/sub/d.txt",
                "type": "file",
                "content_utf8": "delta\n"
              },
              {
                "path": "c.json",
                "type": "file",
                "content_utf8": "{\n  \"name\": \"app\",\n  \"version\": \"1.0.0\"\n}\n"
              },
              {
                "path": "w.txt",
                "type": "file",
                "content_utf8": "one\r\ntwo\r\n"
              }
            ]
          }
        }
      ]
    },
