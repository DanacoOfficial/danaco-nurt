          {
            "path": "c.json",
            "type": "file",
            "content_utf8": "{\n  \"name\": \"app\",\n  \"version\": \"1.0.0\"\n}\n"
          },
          {
            "path": "w.txt",
            "type": "file",
            "content_utf8": "one\r\ntwo\r\n"
          }
        ]
      },
      "step": [
        {
          "program": "write \"x.txt\" \"x\\n\" mode: create",
          "expect": {
            "report": {
              "status": "ok"
            }
          }
        },
        {
          "program": "replace \"beta\" \"BETA\" in: [\"a.txt\"]",
          "expect": {
            "report": {
              "status": "ok"
            }
          }
        },
        {
          "program": "remove \"b.txt\"",
          "expect": {
            "report": {
              "status": "ok"
            }
          }
        },
        {
          "program": "undo to: ${step1/report/op}",
          "expect": {
            "report": {
              "status": "ok"
            }
          },
          "fs_after": {
            "entries": [
              {
                "path": "a.txt",
                "type": "file",
                "content_utf8": "alpha\nbeta\n"
              },
              {
                "path": "b.txt",
                "type": "file",
                "content_utf8": "bravo\n"
              },
              {
                "path": "dir/c.txt",
                "type": "file",
                "content_utf8": "charlie\n"
              },
              {
                "path": "dir/sub/d.txt",
                "type": "file",
                "content_utf8": "delta\n"
              },
              {
                "path": "c.json",
                "type": "file",
                "content_utf8": "{\n  \"name\": \"app\",\n  \"version\": \"1.0.0\"\n}\n"
              },
              {
                "path": "w.txt",
                "type": "file",
                "content_utf8": "one\r\ntwo\r\n"
              },
              {
                "path": "x.txt",
                "type": "file",
                "content_utf8": "x\n"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "parity/safety/journal/conflict-report",
      "kind": "parity",
      "class": "optional:journal",
      "summary": "Undo after a later change of the same file reports the conflict and changes nothing.",
      "fs_before": {
        "entries": [
          {
            "path": "a.txt",
            "type": "file",
            "content_utf8": "alpha\nbeta\n"
          },
          {
            "path": "b.txt",
            "type": "file",
            "content_utf8": "bravo\n"
          },
          {
            "path": "dir/c.txt",
            "type": "file",
            "content_utf8": "charlie\n"
          },
          {
            "path": "dir/sub/d.txt",
            "type": "file",
            "content_utf8": "delta\n"
          },
          {
            "path": "c.json",
            "type": "file",
            "content_utf8": "{\n  \"name\": \"app\",\n  \"version\": \"1.0.0\"\n}\n"
          },
          {
            "path": "w.txt",
            "type": "file",
            "content_utf8": "one\r\ntwo\r\n"
          }
        ]
      },
      "step": [
        {
          "program": "replace \"beta\" \"BETA\" in: [\"a.txt\"]",
          "expect": {
            "report": {
              "status": "ok"
            }
          }
        },
        {
          "program": "write \"a.txt\" \"later\\n\" mode: append",
          "expect": {
            "report": {
              "status": "ok"
            }
          }
        },
        {
          "program": "undo ${step1/report/op}",
          "expect": {
            "report": {
              "status": "failed",
              "error": {
                "code": "E_JOURNAL_CONFLICT"
              }
            }
          },
          "fs_after": {
            "entries": [
              {
                "path": "a.txt",
                "type": "file",
                "content_utf8": "alpha\nBETA\nlater\n"
              },
              {
                "path": "b.txt",
                "type": "file",
                "content_utf8": "bravo\n"
              },
              {
                "path": "dir/c.txt",
                "type": "file",
                "content_utf8": "charlie\n"
              },
              {
                "path": "dir/sub/d.txt",
                "type": "file",
                "content_utf8": "delta\n"
              },
              {
                "path": "c.json",
                "type": "file",
                "content_utf8": "{\n  \"name\": \"app\",\n  \"version\": \"1.0.0\"\n}\n"
              },
              {
                "path": "w.txt",
                "type": "file",
                "content_utf8": "one\r\ntwo\r\n"
              }
            ]
          }
        }
      ]
    },
