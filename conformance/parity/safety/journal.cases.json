    {
      "id": "parity/safety/journal/undo-to",
      "kind": "parity",
      "class": "optional:journal",
      "summary": "Undo to an operation reverts every later operation.",
      "fs_before": {
        "entries": [
          {
            "path": "a.txt",
            "type": "file",
            "content_utf8": "alpha\nbeta\n"
          },
          {
            "path": "b.txt",
            "type": "file",
            "content_utf8": "bravo\n"
          },
          {
            "path": "dir/c.txt",
            "type": "file",
            "content_utf8": "charlie\n"
          },
          {
            "path": "dir/sub/d.txt",
            "type": "file",
            "content_utf8": "delta\n"
