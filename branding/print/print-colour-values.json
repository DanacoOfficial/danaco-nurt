{
  "document": "Danaco Nurt print colour values",
  "date": "2026-11-26",
  "method": {
    "intent": "relative colorimetric (transicc -t1)",
    "black_point_compensation": "on for sRGB to CMYK (-b); the printed appearance is read back without -b",
    "commands": {
      "rgb_to_cmyk": "echo \"R G B\" | transicc -n -i'*sRGB' -o<profile> -t1 -b",
      "cmyk_to_lab": "echo \"C M Y K\" | transicc -n -i<profile> -o'*Lab' -t1",
      "cmyk_to_srgb": "echo \"C M Y K\" | transicc -n -i<profile> -o'*sRGB' -t1 -b",
      "rgb_to_lab": "echo \"R G B\" | transicc -n -i'*sRGB' -o'*Lab' -t1",
      "version": "LittleCMS ColorSpace conversion calculator 5.1 [LittleCMS 2.17]"
    },
    "profiles": {
      "fogra39": {
        "file": "/usr/share/color/icc/ISOcoated_v2_bas.ICC",
        "name": "ISO Coated v2 (ECI), FOGRA39, coated paper",
        "tac_limit": 300
      },
      "fogra47": {
        "file": "/usr/share/color/icc/PSO_Uncoated_ISO12647_bas.ICC",
        "name": "PSO Uncoated ISO12647 (ECI), FOGRA47, uncoated wood-free paper",
        "tac_limit": 260
      }
    },
    "source_profile": "sRGB (transicc built-in profile *sRGB)",
    "de2000_definition": "CIEDE2000 (kLCH = 1) in CIELAB D50 between the target colour (sRGB converted to Lab) and the Lab of the integer CMYK recipe read from the print profile (print appearance, no BPC on return). de2000_software_return uses the return conversion CMYK to sRGB with BPC instead.",
    "tac_correction": "If the transicc recipe exceeds the TAC limit, an integer CMYK recipe within the limit with the lowest CIEDE2000 to the target is searched (seeded batched local search, 1 percent steps)."
  },
