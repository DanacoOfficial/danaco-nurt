class Nurt < Formula
  desc "@DESCRIPTION@"
  homepage "https://nurt.danaco-group.pl"
  url "https://github.com/DanacoOfficial/danaco-nurt/archive/refs/tags/v@VERSION@.tar.gz"
  sha256 "@SHA256:source@"
  license "Apache-2.0"
  head "https://github.com/DanacoOfficial/danaco-nurt.git", branch: "main"

  depends_on "rust" => :build

  def install
    system "cargo", "install", *std_cargo_args(path: "crates/nurt-cli")
    include.install "crates/nurt-ffi/include/nurt.h"
  end

  test do
    assert_match(/\Anurt \d/, shell_output("#{bin}/nurt version"))
  end
end
