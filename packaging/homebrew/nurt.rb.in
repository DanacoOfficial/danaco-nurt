class Nurt < Formula
  desc "@DESCRIPTION@"
  homepage "https://nurt.danaco-group.pl"
  version "@VERSION@"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/DanacoOfficial/danaco-nurt/releases/download/v@VERSION@/nurt-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256:aarch64-apple-darwin@"
    end
    on_intel do
      url "https://github.com/DanacoOfficial/danaco-nurt/releases/download/v@VERSION@/nurt-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA256:x86_64-apple-darwin@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/DanacoOfficial/danaco-nurt/releases/download/v@VERSION@/nurt-@VERSION@-aarch64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256:aarch64-unknown-linux-gnu@"
    end
    on_intel do
      url "https://github.com/DanacoOfficial/danaco-nurt/releases/download/v@VERSION@/nurt-@VERSION@-x86_64-unknown-linux-gnu.tar.gz"
      sha256 "@SHA256:x86_64-unknown-linux-gnu@"
    end
  end

  def install
    bin.install "nurt"
    man1.install Dir["man/man1/*"] if (buildpath/"man/man1").directory?
    bash_completion.install "completions/nurt.bash" => "nurt" if (buildpath/"completions/nurt.bash").exist?
    zsh_completion.install "completions/_nurt" if (buildpath/"completions/_nurt").exist?
    fish_completion.install "completions/nurt.fish" if (buildpath/"completions/nurt.fish").exist?
  end

  test do
    assert_match(/\Anurt \d/, shell_output("#{bin}/nurt version"))
  end
end

