<!-- Module:           packaging/chocolatey/nurt.nuspec.in -->
<!-- Responsibility:   Template of the Chocolatey package specification of Danaco Nurt. -->
<!-- Dependencies:     none -->
<!-- Author:           Danaco Official -->
<!-- Version:          0.1.1, 2026-11-27 -->
<!-- License:          see the LICENSE file or https://www.danaco-group.pl -->

<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>nurt</id>
    <version>@CHOCO_VERSION@</version>
    <title>Danaco Nurt</title>
    <authors>Danaco Holding Group Sp. z o.o.</authors>
    <owners>Danaco Holding Group Sp. z o.o.</owners>
    <projectUrl>https://nurt.danaco-group.pl</projectUrl>
    <packageSourceUrl>https://github.com/DanacoOfficial/danaco-nurt/tree/main/packaging/chocolatey</packageSourceUrl>
    <projectSourceUrl>https://github.com/DanacoOfficial/danaco-nurt</projectSourceUrl>
    <docsUrl>https://nurt.danaco-group.pl</docsUrl>
    <bugTrackerUrl>https://github.com/DanacoOfficial/danaco-nurt/issues</bugTrackerUrl>
    <licenseUrl>https://github.com/DanacoOfficial/danaco-nurt/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <copyright>Copyright (c) 2026 Danaco Holding Group Sp. z o.o.</copyright>
    <tags>nurt console shell command-line cli</tags>
    <summary>@DESCRIPTION@</summary>
    <description>Danaco Nurt is a command shell and language where every change can be undone. The package installs the nurt executable.</description>
    <releaseNotes>https://github.com/DanacoOfficial/danaco-nurt/releases/tag/v@VERSION@</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>

