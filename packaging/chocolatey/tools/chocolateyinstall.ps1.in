# Module:           packaging/chocolatey/tools/chocolateyinstall.ps1.in
# Responsibility:   Template of the Chocolatey installation script of Danaco Nurt.
# Dependencies:     none
# Author:           Danaco Official
# Version:          0.1.1, 2026-11-27
# License:          see the LICENSE file or https://www.danaco-group.pl

$ErrorActionPreference = 'Stop'

$toolsDir = Split-Path -Parent $MyInvocation.MyCommand.Definition
$releaseUrl = 'https://github.com/DanacoOfficial/danaco-nurt/releases/download/v@VERSION@'

if ($env:PROCESSOR_ARCHITECTURE -eq 'ARM64' -or $env:PROCESSOR_ARCHITEW6432 -eq 'ARM64') {
    $archive = 'nurt-@VERSION@-aarch64-pc-windows-msvc.zip'
    $checksum = '@SHA256:aarch64-pc-windows-msvc@'
}
else {
    $archive = 'nurt-@VERSION@-x86_64-pc-windows-msvc.zip'
    $checksum = '@SHA256:x86_64-pc-windows-msvc@'
}

$packageArgs = @{
    PackageName   = $env:ChocolateyPackageName
    UnzipLocation = $toolsDir
    Url64bit      = "$releaseUrl/$archive"
    Checksum64    = $checksum
    ChecksumType64 = 'sha256'
}

Install-ChocolateyZipPackage @packageArgs

