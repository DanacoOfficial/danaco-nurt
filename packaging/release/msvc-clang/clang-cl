# Responsibility:   Wrapper of clang-cl for cross builds from Linux.
# Dependencies:     none
# Author:           Danaco Official
# Version:          0.1.2, 2026-11-28
# License:          see the LICENSE file or https://www.danaco-group.pl

# clang-cl for cross builds from Linux: an option /FI followed by an absolute
# Linux path (/FI/home/user/...) is read as a file name, so it is passed as -FI.
# NURT_MSVC_CLANG names the clang executable when it is not /usr/bin/clang.
for argument in "$@"; do
    shift
    case $argument in
        /FI/*) set -- "$@" "-FI${argument#/FI}" ;;
        *) set -- "$@" "$argument" ;;
    esac
done
exec "${NURT_MSVC_CLANG:-/usr/bin/clang}" --driver-mode=cl "$@"

