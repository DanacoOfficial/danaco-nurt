# clang-cl for cross builds from Linux: an option /FI followed by an absolute
# Linux path (/FI/home/user/...) is read as a file name, so it is passed as -FI.
for argument in "$@"; do
    shift
    case $argument in
        /FI/*) set -- "$@" "-FI${argument#/FI}" ;;
        *) set -- "$@" "$argument" ;;
    esac
done
exec /usr/bin/clang --driver-mode=cl "$@"
