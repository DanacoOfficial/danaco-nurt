//
// Module:           packaging/windows-installer/setup.rc.in
// Responsibility:   Template of the Windows resources of the setup: icon, manifest, version information.
// Dependencies:     none
// Author:           Danaco Official
// Version:          0.1.2, 2026-11-28
// License:          see the LICENSE file or https://www.danaco-group.pl

// The build script substitutes the version. Numeric values are written out so that no Windows
// header is needed: 24 is RT_MANIFEST, 0x40004 is VOS_NT_WINDOWS32 and 1 is VFT_APP.

1 ICON "nurt.ico"
1 24 "setup.manifest"

1 VERSIONINFO
FILEVERSION @VERSION_COMMA@
PRODUCTVERSION @VERSION_COMMA@
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 1
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Danaco Holding Group Sp. z o.o."
            VALUE "FileDescription", "Danaco Nurt setup"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "nurt-setup"
            VALUE "LegalCopyright", "Copyright (c) 2026 Danaco Holding Group Sp. z o.o. All rights reserved."
            VALUE "OriginalFilename", "nurt-setup.exe"
            VALUE "ProductName", "Danaco Nurt"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END

