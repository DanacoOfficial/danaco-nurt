<Project>
   <PropertyGroup>
      <TargetFramework>net9.0</TargetFramework>
      <Nullable>enable</Nullable>
      <Version>2.23.1</Version>
      <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
   </PropertyGroup>
   <ItemGroup>
      <PackageReference Include="Package.N0" Version="0.23.0" />
      <PackageReference Include="Package.N1" Version="1.23.0" />
      <PackageReference Include="Package.N2" Version="2.23.0" />
      <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
   </ItemGroup>
   <Target Name="Stamp" BeforeTargets="Build">
      <Message Text="Building $(MSBuildProjectName) &amp; stamping" Importance="high" />
   </Target>
</Project>
