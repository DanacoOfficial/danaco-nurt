<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:p="http://www.springframework.org/schema/p">
	<context:component-scan base-package="com.example.s14"/>
	<bean id="dataSource" class="org.example.Pool" p:maxSize="24">
		<property name="url" value="jdbc:h2:mem:db14;MODE=PostgreSQL"/>
		<property name="user" value="sa"/>
	</bean>
	<!-- service layer -->
	<bean id="service" class="org.example.Service">
		<constructor-arg ref="dataSource"/>
		<property name="query"><value><![CDATA[SELECT * FROM t WHERE a < 14 AND b > 0]]></value></property>
	</bean>
</beans>
