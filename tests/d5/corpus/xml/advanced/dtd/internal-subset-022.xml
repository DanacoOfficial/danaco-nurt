<!DOCTYPE recipe [
  <!ELEMENT recipe (title, ingredient*, step+)>
  <!ELEMENT title (#PCDATA)>
  <!ELEMENT ingredient EMPTY>
  <!ELEMENT step (#PCDATA | em)*>
  <!ELEMENT em (#PCDATA)>
  <!ATTLIST ingredient name CDATA #REQUIRED amount CDATA #IMPLIED>
  <!ENTITY oven "the oven at 180 degrees">
]>
<recipe>
  <title>Bread</title>
  <ingredient name="flour" amount="500 g"/>
  <ingredient name="water" amount="350 ml"/>
  <step>Preheat &oven;.</step>
  <step>Bake for <em>40</em> minutes in &oven;.</step>
</recipe>
