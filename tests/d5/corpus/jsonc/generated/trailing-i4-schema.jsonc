{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/schemas/order.json",
    "title": "Order",
    "type": "object",
    "required": [
        "id",
        "items"
    ],
    "properties": {
        "id": {
            "type": "string",
            "pattern": "^[A-Z]{2}-\\d{6}$",
        },
        "items": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/item"
            }
        },
        "total": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.01,
        }
    },
    "$defs": {
        "item": {
            "type": "object",
            "properties": {
                "sku": {
                    "type": "string",
                },
                "quantity": {
                    "type": "integer",
                    "minimum": 1,
                }
            },
            "additionalProperties": false,
        }
    }
}
