{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=db;Database=app;Trusted_Connection=False",
  },
  "RetryPolicy": {
    "Attempts": 3,
    "BackoffSeconds": 1.5,
    "Enabled": true,
  }
}
