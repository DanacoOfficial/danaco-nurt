{
  "tasks": {
    "dev": "deno run --watch main.ts" // development server
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-explicit-any"],
    },
  },
  "fmt": {"useTabs": false, "lineWidth": 100},
}
