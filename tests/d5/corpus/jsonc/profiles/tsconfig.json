{
  // Shared compiler settings for all packages.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    /* Emit declarations for library consumers. */
    "declaration": true,
    "outDir": "./dist",
    "paths": {
      "@app/*": ["./src/*"], // path alias used by the bundler
    },
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist", // build output
  ],
}
