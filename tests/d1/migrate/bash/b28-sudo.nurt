# B28: commands with privilege elevation.
# untranslated: E_UNCORRECTABLE: sudo rm /etc/app.conf
#   problem: `sudo` is not translated; privileges are not raised, and the program runs with the privileges of the console (privilege_elevation)
#   fix: remove "/etc/app.conf" on_missing: error
