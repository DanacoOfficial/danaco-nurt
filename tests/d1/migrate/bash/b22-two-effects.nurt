# B22: two effects joined with && and with ;.
# translated: B05, L21, B04
create "/srv/out" type: directory
copy "/srv/a.txt" to: "/srv/out" preserve: false
# translated: B01, L21
# assumption: the script stops at the first error; bash continues after `;`
# assumption: the script stops on the first error; the shell runs a statement after `;` even when the previous one fails
remove "/srv/a.txt" on_missing: error
remove "/srv/b.txt" on_missing: error
