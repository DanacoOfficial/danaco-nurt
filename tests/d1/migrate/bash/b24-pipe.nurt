# B24: pipelines of translatable commands.
# translated: B10, L21, B15, B24
lines "/var/log/app.log"
|> search /ERROR/
# translated: B13, L21, B12, B24
list "/srv/app" hidden: false
|> count
# translated: B14, L21, B11, B24
find "/srv" glob: "**/*.log" type: any
|> first 5
