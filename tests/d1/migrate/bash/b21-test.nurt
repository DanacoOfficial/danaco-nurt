# B21: test and brackets guarding a command.
# translated: B41, B01, L21
when exists("/srv/app/.ready") and ((info "/srv/app/.ready" |> first 1)).type == "file" {
    remove "/srv/app/.ready" on_missing: error
}
# translated: B41, B01, L21
when exists("/srv/app/out") and ((info "/srv/app/out" |> first 1)).type == "directory" {
    remove "/srv/app/out"
}
