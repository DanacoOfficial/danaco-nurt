# B15: grep with recursion, case, inversion, counts and file lists.
# translated: B15, L21
# assumption: the pattern is read as literal text
search "oldName(" "/srv/app/src"
# translated: B15, L21
search /error/ "/var/log/app.log" case_sensitive: false
# translated: B15, L21
search /func main/ "/srv/app" output: files glob: "**/*.go"
# translated: B15, L21
search /GET \// "/var/log/nginx/access.log" output: counts
# translated: B15, L21
search /^#|^$/ "/etc/app.conf" invert: true
# translated: B15, L21
search /timeout/ "/etc/app.conf" whole_word: true context: 2
