# B20: cd followed by a command on the same line.
# translated: B20, B38
run ["go", "test", "./..."] cwd: "/srv/app"
# translated: B20, B38
# assumption: the script stops at the first error; bash continues after `;`
run ["make", "build"] cwd: "/srv/app"
# untranslated: E_UNCORRECTABLE: cd build && make
