# B34: tar, zip and gzip.
# translated: B34, L21
archive.extract "/tmp/app.tgz" into: "/srv/app"
# translated: B34, L21
find "/srv/app" type: any
|> archive.create "/srv/backup/app.tgz" format: tar_gz base: "/"
# translated: B34, L21
archive.extract "/tmp/data.zip" into: "/srv/data"
# translated: B34, L21
find "/srv/out" type: any
|> archive.create "/srv/out.zip" format: zip base: "/"
# translated: B34, L21
compress "/var/log/app.log" keep: false
# translated: B34, L21
decompress "/srv/data.csv.gz" keep: false
