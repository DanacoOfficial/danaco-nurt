# B26: command substitution bound to a variable and used later.
# translated: B26
let logs = find "/var/log/app" glob: "**/*.log" type: any
# translated: B01, B25
remove @logs on_missing: error
# translated: B26
let count = lines "/srv/a.txt"
|> count
# untranslated: E_UNCORRECTABLE: echo $COUNT
#   problem: `$$COUNT` is not substituted inside text; paths are quoted absolute text: write the path, or use a field of a named result such as `@x.path` (variable_in_text)
