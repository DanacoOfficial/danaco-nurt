# B14: find with name, type, time, size, depth and delete.
# translated: B14, L21
find "/srv/app" glob: "**/*.log" type: file
|> filter modified > ago(7d)
# translated: B14, L21
find "/tmp" glob: "**/*.tmp" type: any
|> remove
# translated: B14, L21
find "/srv" depth: 2 type: directory glob: "**/build"
# translated: B14, L21
# assumption: the size units k, M and G of find are binary (KiB, MiB, GiB)
find "/srv" glob: "**/readme*" case_sensitive: false type: any
|> filter size > 1mib
