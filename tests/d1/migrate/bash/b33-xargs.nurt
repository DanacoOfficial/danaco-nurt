# B33: xargs and find -exec.
# translated: B14, L21, B01, B33
# assumption: file names contain no whitespace; xargs splits its input at whitespace
find "/srv" glob: "**/*.bak" type: any
|> remove on_missing: error
# translated: B14, B07, L21, B33
find "/srv/app" glob: "**/*.sh" type: any
|> attributes mode: "755"
# untranslated: E_UNCORRECTABLE: find /srv/app -name "*.go" | xargs gofmt -l
