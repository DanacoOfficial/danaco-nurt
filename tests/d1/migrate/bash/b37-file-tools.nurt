# B37: diff, counting, sizes, hashes and conversions.
# translated: B37, L21
diff "/srv/a.conf" "/srv/b.conf"
# translated: B37, L21, B24
lines "/srv/words.txt"
|> sort text
|> group by: text
# translated: B37, L21
find "/srv/app"
|> summarize size
# translated: B37, L21
info "/srv/app/data.db"
# translated: B37, L21
info "/srv/app/bin/run" details: [text]
# translated: B37, L21
hash "/srv/app.tgz"
# translated: B37, L21
convert "/srv/a.txt" line_ending: lf
# translated: B37, L21
# assumption: the file is converted in place; iconv writes the result to standard output
convert "/srv/a.txt" encoding: "utf-8"
