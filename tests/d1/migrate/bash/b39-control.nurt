# B39: loops, conditions, functions, case and here-documents.
# translated: B41, B34, B25
each (find "/srv/logs" glob: "*.log" depth: 1 hidden: false) as f {
    compress @f.path keep: false
}
# translated: B41, B40
while true {
    sleep 5s
}
# translated: B41, B19
when exists("/srv/app/.ready") and ((info "/srv/app/.ready" |> first 1)).type == "file" {
    evaluate "ready"
}
# translated: B41, B19
when @arg1 == "start" {
    evaluate "start"
} otherwise when @arg1 == "stop" {
    evaluate "stop"
}
# untranslated: E_UNCORRECTABLE: deploy() { rsync -a /srv/app/ /srv/www/; }
#   problem: the working directory of the program is not given; write `cd <absolute path> &&` before it or use one of the fixes (working_directory)
#   fix: run ["rsync", "-a", "/srv/app/", "/srv/www/"] cwd: "/srv"
# translated: B39, L21
write "/srv/app/motd" "Maintenance at 22:00.\n" mode: overwrite
