# B02: rm with a glob expanded by the shell.
# translated: B02, L21
find "/srv/app/build" glob: "*.tmp" depth: 1 hidden: false
|> remove on_missing: error
# translated: B02, L21
find "/var/log/app" glob: "*.gz" depth: 1 hidden: false
|> remove
