# P28: JSON and CSV conversions.
# translated: P03, L19, P28
# assumption: the document is read as a whole and its values are returned as items
read "C:/data.json" key: "$"
# translated: P28, L19
# assumption: every row of the file is returned as an item keyed by the header
read "C:/data.csv" key: "[*]"
# translated: P22, P28, L19
# assumption: the fields of the records become the columns of the file
processes |> write "C:/out/processes.csv" format: csv mode: overwrite
# untranslated: E_UNCORRECTABLE: Get-Service | ConvertTo-Json
#   problem: ConvertTo-Json only shows text unless a file is written; write the records with write format: json (conversion_without_write)
