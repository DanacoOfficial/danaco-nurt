# P02: recursive Get-ChildItem with filters.
# translated: P02, L19
find "C:/proj" glob: "**/*.go" type: any hidden: false
# translated: P02, L19
find "C:/proj" depth: 3 type: file hidden: false
# translated: P02, L19
find "C:/logs" hidden: true type: any
|> filter name ~ /(?:\.log$|\.txt$)/i
|> select name
