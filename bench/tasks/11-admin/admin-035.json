{
  "format": "nurt-bench-task/1",
  "id": "admin-035",
  "domain": 11,
  "split": "public",
  "platform": "cross",
  "nl": "Which accounts in etc/passwd have /usr/sbin/nologin as shell? List the account names (question 4).",
  "fs_before": {
    "fixture": "etc-tree"
  },
  "expect": {
    "answer": {
      "not_contains": [
        "root\n",
        "user\n",
        "deploy\n"
      ],
      "regex": [
        "(?m)^daemon$|\\bdaemon\\b",
        "(?m)^orders$|\\borders\\b",
        "(?m)^backup$|\\bbackup\\b"
      ]
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "read \"etc/passwd\" |> split \":\" names: [\"name\", \"x\", \"uid\", \"gid\", \"info\", \"home\", \"shell\"] |> filter shell == \"/usr/sbin/nologin\" |> select name",
  "reference_bash": "awk -F: '$7 == \"/usr/sbin/nologin\" { print $1 }' etc/passwd\n",
  "reference_pwsh": "Get-Content etc/passwd | ForEach-Object { $f = $_.Split(':'); if ($f[6] -eq '/usr/sbin/nologin') { $f[0] } }\n",
  "tags": [
    "accounts",
    "report"
  ],
  "license": "CC-BY-4.0"
}
