{
  "format": "nurt-bench-task/1",
  "id": "admin-031",
  "domain": 11,
  "split": "public",
  "platform": "linux",
  "nl": "Which units are enabled for multi-user.target in this tree (links in etc/systemd/system/multi-user.target.wants/)? (1 expected)",
  "fs_before": {
    "fixture": "etc-tree",
    "overlay": [
      {
        "path": "etc/systemd/system/extra3.service",
        "type": "file",
        "content_utf8": "[Service]\nExecStart=/opt/extra3\n"
      },
      {
        "path": "etc/systemd/system/mailer.service",
        "type": "file",
        "content_utf8": "[Service]\nExecStart=/opt/mailer\n"
      },
      {
        "path": "etc/systemd/system/multi-user.target.wants/orders.service",
        "type": "symlink",
        "target": "../orders.service"
      }
    ]
  },
  "expect": {
    "answer": {
      "contains": [
        "orders.service"
      ],
      "not_contains": [
        "reports.service",
        "extra3.service",
        "mailer.service"
      ]
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "list \"etc/systemd/system/multi-user.target.wants\" type: link |> select name",
  "reference_bash": "ls etc/systemd/system/multi-user.target.wants/\n",
  "tags": [
    "report",
    "systemd"
  ],
