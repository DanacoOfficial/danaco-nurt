{
  "format": "nurt-bench-task/1",
  "id": "admin-044",
  "domain": 11,
  "split": "public",
  "platform": "cross",
  "nl": "Set LOG_LEVEL=warn in admin/services/orders.env.",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "admin/jobs.json",
        "type": "file",
        "content_utf8": "[\n  {\n    \"name\": \"cleanup\",\n    \"cron\": \"0 3 * * *\",\n    \"command\": \"cleanup --days 14\",\n    \"enabled\": true\n  },\n  {\n    \"name\": \"sync\",\n    \"cron\": \"*/15 * * * *\",\n    \"command\": \"sync --all\",\n    \"enabled\": true\n  },\n  {\n    \"name\": \"legacy-export\",\n    \"cron\": \"0 1 * * 0\",\n    \"command\": \"export --legacy\",\n    \"enabled\": false\n  }\n]\n"
      },
      {
        "path": "admin/services/legacy.conf",
        "type": "file",
        "content_utf8": "name = legacy\nport = 8090\nenabled = true\n"
      },
      {
        "path": "admin/services/orders.conf",
        "type": "file",
        "content_utf8": "name = orders\nport = 8080\nenabled = true\n"
      },
      {
        "path": "admin/services/orders.env",
        "type": "file",
        "content_utf8": "LOG_LEVEL=info\nWORKERS=4\n"
      }
    ]
  },
  "expect": {
    "files": {
      "admin/services/orders.env": {
        "text": "LOG_LEVEL=warn\nWORKERS=4\n"
      }
    }
  },
  "forbidden": [
    {
      "path": "admin/services/*.conf",
      "change": "delete",
      "reason": "service definitions are kept"
    }
  ],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "replace \"LOG_LEVEL=info\" \"LOG_LEVEL=warn\" in: [\"admin/services/orders.env\"] mode: literal expect: 1",
  "reference_bash": "python3 - <<'EOF'\nimport pathlib\np = pathlib.Path('admin/services/orders.env'); t = p.read_text()\nassert t.count('LOG_LEVEL=info') == 1\np.write_text(t.replace('LOG_LEVEL=info', 'LOG_LEVEL=warn'))\nEOF\n",
  "reference_pwsh": "$p = Join-Path $PWD 'admin/services/orders.env'; $t = [IO.File]::ReadAllText($p)\n[IO.File]::WriteAllText($p, $t.Replace('LOG_LEVEL=info', 'LOG_LEVEL=warn'))\n",
  "tags": [
    "admin",
    "config"
  ],
  "license": "CC-BY-4.0"
}
