{
  "format": "nurt-bench-task/1",
  "id": "archives-017",
  "domain": 9,
  "split": "public",
  "platform": "linux",
  "nl": "Extract only the member release/config/default.toml from release.tar.gz and store it as restored/default.toml. Extract nothing else (archive 1).",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "release.tar.gz",
        "type": "file",
        "content_base64": ""
      }
    ]
  },
  "expect": {
    "files": {
      "restored/default.toml": {
        "text": "level = 1\n"
      }
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "archive.extract \"release.tar.gz\" into: \"restored\" only: [\"release/config/default.toml\"] strip_components: 2",
  "reference_bash": "mkdir -p restored && tar -xzf release.tar.gz -C restored --strip-components=2 release/config/default.toml\n",
  "negatives": [
    {
      "shell": "bash",
      "script": "tar -xzf release.tar.gz",
      "defect": "extracts the whole archive into the root"
    }
  ],
  "tags": [
    "extract",
    "tar"
  ],
  "license": "CC-BY-4.0"
}
