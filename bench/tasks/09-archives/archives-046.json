{
  "format": "nurt-bench-task/1",
  "id": "archives-046",
  "domain": 9,
  "split": "public",
  "platform": "windows",
  "nl": "Decompress incoming/records-3.jsonl.gz to incoming/records-3.jsonl and keep the compressed file.",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "incoming/records-3.jsonl.gz",
        "type": "file",
        "content_base64": "H4sIAAAAAAAC/6tWykxRslIw0FFQSkosSc4Aso1quaohooZYRY2wihpjFTVBFQUAhBASBm4AAAA="
      }
    ]
  },
  "expect": {
    "files": {
      "incoming/records-3.jsonl": {
        "text": "{\"id\": 0, \"batch\": 2}\n{\"id\": 1, \"batch\": 2}\n{\"id\": 2, \"batch\": 2}\n{\"id\": 3, \"batch\": 2}\n{\"id\": 4, \"batch\": 2}\n"
      }
    }
