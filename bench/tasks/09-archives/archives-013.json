{
  "format": "nurt-bench-task/1",
  "id": "archives-013",
  "domain": 9,
  "split": "public",
  "platform": "linux",
  "nl": "Which .sql files does the archive archives/backup-2.zip contain? List their paths inside the archive without extracting it.",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "archives/README.txt",
        "type": "file",
        "content_utf8": "Nightly backups\n"
      },
      {
        "path": "archives/backup-2.zip",
        "type": "file",
        "content_base64": ""
      }
    ]
  },
  "expect": {
    "answer": {
      "contains": [
        "backup/db/dump-0.sql",
        "backup/db/dump-1.sql",
        "backup/db/dump-2.sql"
      ],
      "not_contains": [
        "app.conf"
      ]
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "archive.list \"archives/backup-2.zip\" glob: \"**/*.sql\"",
  "reference_bash": "python3 -m zipfile -l archives/backup-2.zip | grep '\\.sql'\n",
  "tags": [
    "archive",
    "list"
  ],
  "license": "CC-BY-4.0"
}
