{
  "format": "nurt-bench-task/1",
  "id": "archives-020",
  "domain": 9,
  "split": "public",
  "platform": "windows",
  "nl": "Extract only the member release/README.txt from release.tar.gz and store it as restored/README.txt. Extract nothing else (archive 4).",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "release.tar.gz",
        "type": "file",
        "content_base64": ""
      }
    ]
  },
  "expect": {
    "files": {
      "restored/README.txt": {
        "text": "Release notes\n"
      }
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "archive.extract \"release.tar.gz\" into: \"restored\" only: [\"release/README.txt\"] strip_components: 1",
  "reference_pwsh": "New-Item -ItemType Directory -Force restored | Out-Null\ntar -xzf release.tar.gz -C restored --strip-components 1 release/README.txt\n",
  "tags": [
    "extract",
    "tar"
  ],
  "license": "CC-BY-4.0"
}
