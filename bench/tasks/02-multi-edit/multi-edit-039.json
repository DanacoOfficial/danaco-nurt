{
  "format": "nurt-bench-task/1",
  "id": "multi-edit-039",
  "domain": 2,
  "split": "public",
  "platform": "windows",
  "nl": "Turn off debugging in every .conf file under conf.d/: each active setting 'debug = true' (with or without spaces around '=') becomes 'debug = false'; extra5.conf is included. Comments and other files stay unchanged.",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "conf.d/api.conf",
        "type": "file",
        "content_utf8": "[main]\r\nname = api\r\ndebug = true\r\nport = 8081\r\n"
      },
      {
        "path": "conf.d/extra5.conf",
        "type": "file",
        "content_utf8": "[main]\r\ndebug=true\r\n"
      },
      {
        "path": "conf.d/notes.txt",
        "type": "file",
        "content_utf8": "debug = true\r\n"
      },
      {
        "path": "conf.d/web.conf",
        "type": "file",
        "content_utf8": "[main]\r\nname = web\r\ndebug = true\r\n# debug = true enables tracing\r\n"
      },
      {
        "path": "conf.d/worker.conf",
        "type": "file",
        "content_utf8": "[main]\r\nname = worker\r\ndebug = false\r\n"
      }
    ]
  },
  "expect": {
    "files": {
      "conf.d/api.conf": {
        "text": "[main]\r\nname = api\r\ndebug = false\r\nport = 8081\r\n"
      },
      "conf.d/extra5.conf": {
        "text": "[main]\r\ndebug = false\r\n"
      },
      "conf.d/web.conf": {
        "text": "[main]\r\nname = web\r\ndebug = false\r\n# debug = true enables tracing\r\n"
      }
    }
  },
  "forbidden": [
    {
      "path": "conf.d/notes.txt",
      "change": "any",
      "reason": "not a configuration file"
    }
  ],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "search /^debug\\s*=\\s*true$/ \"conf.d\" glob: \"*.conf\" |> replace \"debug = false\"",
  "reference_pwsh": "Get-ChildItem conf.d -Recurse -File -Include '*.conf' | ForEach-Object {\n  $t = [IO.File]::ReadAllText($_.FullName)\n  $n = $t -creplace '(?m)^debug[ \\t]*=[ \\t]*true(?=\\r?$)', 'debug = false'\n  if ($n -cne $t) { [IO.File]::WriteAllText($_.FullName, $n) }\n}\n",
  "tags": [
    "config",
    "replace"
  ],
  "license": "CC-BY-4.0"
}
