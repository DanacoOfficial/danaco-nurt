{
  "format": "nurt-bench-task/1",
  "id": "multi-edit-051",
  "domain": 2,
  "split": "public",
  "platform": "cross",
  "nl": "Remove trailing spaces and tabs at the end of lines in all .md files under notes/ (recursively). Keep the existing line endings. The tree includes notes/sub/c2.md.",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "notes/a.md",
        "type": "file",
        "content_utf8": "# Title  \n\nText with trailing spaces   \nClean line\n"
      },
      {
        "path": "notes/b.md",
        "type": "file",
        "content_utf8": "- item\t\n- item two \n"
      },
      {
        "path": "notes/data.csv",
        "type": "file",
        "content_utf8": "a,b \nc,d \n"
      },
      {
        "path": "notes/sub/c2.md",
        "type": "file",
        "content_utf8": "No trailing\nwhite space here\n"
      }
    ]
  },
  "expect": {
    "files": {
      "notes/a.md": {
        "text": "# Title\n\nText with trailing spaces\nClean line\n"
      },
      "notes/b.md": {
        "text": "- item\n- item two\n"
      }
    }
  },
  "forbidden": [
    {
      "path": "notes/data.csv",
      "change": "any",
      "reason": "CSV data is not part of the request"
    }
  ],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "search /[ \\t]+$/ \"notes\" glob: \"**/*.md\" |> replace \"\"",
  "reference_bash": "find notes -type f -name '*.md' -exec sed -i -E 's/[[:blank:]]+(\\r?)$/\\1/' {} +\n",
  "reference_pwsh": "Get-ChildItem notes -Recurse -File -Include '*.md' | ForEach-Object {\n  $t = [IO.File]::ReadAllText($_.FullName)\n  $n = $t -creplace '(?m)[ \\t]+(?=\\r?$)', ''\n  if ($n -cne $t) { [IO.File]::WriteAllText($_.FullName, $n) }\n}\n",
  "tags": [
    "markdown",
    "whitespace"
  ],
  "license": "CC-BY-4.0"
}
