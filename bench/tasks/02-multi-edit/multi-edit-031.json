{
  "format": "nurt-bench-task/1",
  "id": "multi-edit-031",
  "domain": 2,
  "split": "public",
  "platform": "linux",
  "nl": "Rename every .jpeg file in site/img/ to the extension .jpg and update the src attributes in the HTML files under site/ that refer to them (hero, team and office1). Do not change other text.",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "site/about.html",
        "type": "file",
        "content_utf8": "<img src=\"img/team.jpeg\">\n<p>Photos are stored as .jpeg files.</p>\n"
      },
      {
        "path": "site/img/hero.jpeg",
        "type": "file",
        "content_base64": "/9j/4AEEaGVybw=="
      },
      {
        "path": "site/img/logo.png",
        "type": "file",
        "content_base64": "iVBORw0KGgpsb2dv"
      },
      {
        "path": "site/img/office1.jpeg",
        "type": "file",
        "content_base64": "/9j/4AEHb2ZmaWNlMQ=="
      },
      {
        "path": "site/img/team.jpeg",
        "type": "file",
        "content_base64": "/9j/4AEEdGVhbQ=="
      },
      {
        "path": "site/index.html",
        "type": "file",
        "content_utf8": "<img src=\"img/hero.jpeg\" alt=\"hero\">\n<img src=\"img/team.jpeg\" alt=\"team\">\n<img src=\"img/office1.jpeg\" alt=\"office1\">\n<img src=\"img/logo.png\">\n"
      }
    ]
  },
  "expect": {
    "files": {
      "site/about.html": {
        "text": "<img src=\"img/team.jpg\">\n<p>Photos are stored as .jpeg files.</p>\n"
      },
      "site/img/hero.jpeg": {
        "absent": true
      },
      "site/img/hero.jpg": {
        "base64": "/9j/4AEEaGVybw=="
      },
      "site/img/office1.jpeg": {
        "absent": true
      },
      "site/img/office1.jpg": {
        "base64": "/9j/4AEHb2ZmaWNlMQ=="
      },
      "site/img/team.jpeg": {
        "absent": true
      },
      "site/img/team.jpg": {
        "base64": "/9j/4AEEdGVhbQ=="
      },
      "site/index.html": {
        "text": "<img src=\"img/hero.jpg\" alt=\"hero\">\n<img src=\"img/team.jpg\" alt=\"team\">\n<img src=\"img/office1.jpg\" alt=\"office1\">\n<img src=\"img/logo.png\">\n"
      }
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "find \"site/img\" glob: \"*.jpeg\" |> rename /\\.jpeg$/ \".jpg\"\nsearch /(src=\"img\\/[^\"]+)\\.jpeg\"/ \"site\" glob: \"*.html\" |> replace \"${1}.jpg\\\"\"",
  "reference_bash": "for f in site/img/*.jpeg; do mv -- \"$f\" \"${f%.jpeg}.jpg\"; done\nsed -i -E 's/(src=\"img\\/[^\"]+)\\.jpeg\"/\\1.jpg\"/g' site/*.html\n",
  "negatives": [
    {
      "shell": "bash",
      "script": "for f in site/img/*.jpeg; do mv -- \"$f\" \"${f%.jpeg}.jpg\"; done\nsed -i 's/\\.jpeg/.jpg/g' site/*.html",
      "defect": "also rewrites the prose that mentions .jpeg"
    }
  ],
  "tags": [
    "html",
    "rename"
  ],
  "license": "CC-BY-4.0"
}
