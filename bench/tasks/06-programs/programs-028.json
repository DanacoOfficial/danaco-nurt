{
  "format": "nurt-bench-task/1",
  "id": "programs-028",
  "domain": 6,
  "split": "public",
  "platform": "linux",
  "nl": "Feed input-2.txt to the standard input of tools/upper.py and write the program's output to output-2.txt.",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "input-2.txt",
        "type": "file",
        "content_utf8": "north wind\nsouth wind\neast\n"
      },
      {
        "path": "tools/upper.py",
        "type": "file",
        "content_utf8": "import sys\n\nfor line in sys.stdin:\n    print(line.rstrip(\"\\n\").upper())\n"
      }
    ]
  },
  "expect": {
    "files": {
      "output-2.txt": {
        "lines": [
          "NORTH WIND",
          "SOUTH WIND",
          "EAST"
        ]
      }
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "run [\"python3\", \"tools/upper.py\"] stdin: (read \"input-2.txt\") save_to: \"output-2.txt\"",
  "reference_bash": "python3 tools/upper.py < input-2.txt > output-2.txt\n",
  "tags": [
    "run",
    "stdin"
  ],
  "license": "CC-BY-4.0"
}
