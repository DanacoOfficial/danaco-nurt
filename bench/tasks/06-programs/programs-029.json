{
  "format": "nurt-bench-task/1",
  "id": "programs-029",
  "domain": 6,
  "split": "public",
  "platform": "cross",
  "nl": "Feed input-3.txt to the standard input of tools/upper.py and write the program's output to output-3.txt.",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "input-3.txt",
        "type": "file",
        "content_utf8": "one\n"
      },
      {
        "path": "tools/upper.py",
        "type": "file",
        "content_utf8": "import sys\n\nfor line in sys.stdin:\n    print(line.rstrip(\"\\n\").upper())\n"
      }
    ]
  },
  "expect": {
    "files": {
      "output-3.txt": {
        "lines": [
          "ONE"
        ]
      }
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "run [\"python3\", \"tools/upper.py\"] stdin: (read \"input-3.txt\") save_to: \"output-3.txt\"",
  "reference_bash": "python3 tools/upper.py < input-3.txt > output-3.txt\n",
  "reference_pwsh": "$py = if ($IsWindows) { 'python' } else { 'python3' }\nGet-Content input-3.txt | & $py tools/upper.py | Set-Content output-3.txt\n",
  "tags": [
    "run",
    "stdin"
  ],
  "license": "CC-BY-4.0"
}
