{
  "format": "nurt-bench-task/1",
  "id": "programs-030",
  "domain": 6,
  "split": "public",
  "platform": "cross",
  "nl": "Feed input-4.txt to the standard input of tools/upper.py and write the program's output to output-4.txt.",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "input-4.txt",
        "type": "file",
        "content_utf8": "x1\ny2\nz3\nw4\n"
      },
      {
        "path": "tools/upper.py",
        "type": "file",
        "content_utf8": "import sys\n\nfor line in sys.stdin:\n    print(line.rstrip(\"\\n\").upper())\n"
      }
    ]
  },
  "expect": {
    "files": {
      "output-4.txt": {
        "lines": [
          "X1",
          "Y2",
          "Z3",
          "W4"
        ]
      }
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "run [\"python3\", \"tools/upper.py\"] stdin: (read \"input-4.txt\") save_to: \"output-4.txt\"",
  "reference_bash": "python3 tools/upper.py < input-4.txt > output-4.txt\n",
  "reference_pwsh": "$py = if ($IsWindows) { 'python' } else { 'python3' }\nGet-Content input-4.txt | & $py tools/upper.py | Set-Content output-4.txt\n",
  "tags": [
    "run",
    "stdin"
  ],
  "license": "CC-BY-4.0"
}
