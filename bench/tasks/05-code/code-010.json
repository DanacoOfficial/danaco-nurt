{
  "format": "nurt-bench-task/1",
  "id": "code-010",
  "domain": 5,
  "split": "public",
  "platform": "cross",
  "nl": "Where is the function low_stock defined? Answer with the relative file path and the line number.",
  "fs_before": {
    "fixture": "py-inventory"
  },
  "expect": {
    "answer": {
      "contains": [
        "inventory/models.py"
      ],
      "regex": [
        "(?<!\\d)18(?!\\d)"
      ]
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "code.symbols \"low_stock\" path: [\".\"] kind: function",
  "reference_bash": "grep -rn 'def low_stock\\b' --include='*.py' .\n",
  "reference_pwsh": "Get-ChildItem -Recurse -File -Filter '*.py' | Select-String -Pattern 'def low_stock\\b' | ForEach-Object { \"$((Resolve-Path -Relative $_.Path) -replace '\\\\', '/'):$($_.LineNumber)\" }\n",
