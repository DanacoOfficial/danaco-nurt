{
  "format": "nurt-bench-task/1",
  "id": "system-042",
  "domain": 8,
  "split": "public",
  "platform": "cross",
  "nl": "Which command line arguments was the process whose PID is in run/mailer.pid started with?",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "run/.keep",
        "type": "file",
        "content_utf8": ""
      },
      {
        "path": "tools/idle.py",
        "type": "file",
        "content_utf8": "import time\n\nwhile True:\n    time.sleep(1)\n"
      }
    ]
  },
  "setup": {
    "description": "tools/idle.py --queue orders-4 --batch 100 --mark cmdline-4 runs; its PID is in run/mailer.pid.",
    "bash": "setsid python3 tools/idle.py --queue orders-4 --batch 100 --mark cmdline-4 > /dev/null 2>&1 < /dev/null &\necho $! > run/mailer.pid",
    "pwsh": "$py = if ($IsWindows) { 'python' } else { 'python3' }\n$p = Start-Process $py -ArgumentList 'tools/idle.py','--queue','orders-4','--batch','100','--mark','cmdline-4' -PassThru\nSet-Content run/mailer.pid $p.Id"
  },
  "teardown": {
    "bash": "pkill -f -- cmdline-4 || true",
    "pwsh": "Get-Process | Where-Object { $_.CommandLine -like '*cmdline-4*' } | Stop-Process -Force -ErrorAction SilentlyContinue"
  },
  "expect": {
    "answer": {
      "contains": [
        "--queue orders-4",
        "--batch 100"
      ]
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "processes pid: (read \"run/mailer.pid\" |> evaluate int(text)) |> select command",
  "reference_bash": "tr '\\0' ' ' < /proc/$(cat run/mailer.pid)/cmdline; echo\n",
  "reference_pwsh": "$py = if ($IsWindows) { 'python' } else { 'python3' }\n(Get-Process -Id ([int](Get-Content run/mailer.pid))).CommandLine\n",
  "tags": [
    "command-line",
    "processes"
  ],
  "license": "CC-BY-4.0"
}
