{
  "format": "nurt-bench-task/1",
  "id": "system-026",
  "domain": 8,
  "split": "public",
  "platform": "linux",
  "nl": "The symbolic link current points to releases/v0.8.0. Switch it to releases/v0.9.0 by replacing the link (relative target). Do not modify the release directories.",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "current",
        "type": "symlink",
        "target": "releases/v0.8.0"
      },
      {
        "path": "releases/v0.8.0/app.txt",
        "type": "file",
        "content_utf8": "app 0.8.0\n"
      },
      {
        "path": "releases/v0.9.0/app.txt",
        "type": "file",
        "content_utf8": "app 0.9.0\n"
      }
    ]
  },
  "expect": {
    "files": {
      "current": {
        "type": "symlink",
        "target": "releases/v0.9.0"
      }
    }
  },
  "forbidden": [
    {
      "path": "releases/**",
      "change": "any",
      "reason": "release directories are immutable"
    }
  ],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "create \"current\" type: link target: \"releases/v0.9.0\" on_exists: replace",
  "reference_bash": "ln -sfn releases/v0.9.0 current\n",
  "negatives": [
    {
      "shell": "bash",
      "script": "ln -sf releases/v0.9.0 current",
      "defect": "creates a link inside the old release directory"
    }
  ],
  "tags": [
    "symlink"
  ],
  "license": "CC-BY-4.0"
}
