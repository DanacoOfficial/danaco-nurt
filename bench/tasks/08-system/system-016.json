{
  "format": "nurt-bench-task/1",
  "id": "system-016",
  "domain": 8,
  "split": "public",
  "platform": "cross",
  "nl": "Which subdirectory of var/ uses the most space (sum of file sizes, including nested files)? (case 4)",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "var/cache/a.bin",
        "type": "file",
        "content_utf8": ""
      },
      {
        "path": "var/cache/sub/b.bin",
        "type": "file",
        "content_utf8": ""
      },
      {
        "path": "var/logs/a.bin",
        "type": "file",
        "content_utf8": ""
      },
      {
        "path": "var/logs/sub/b.bin",
        "type": "file",
        "content_utf8": ""
      },
      {
        "path": "var/tmp/a.bin",
        "type": "file",
        "content_utf8": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
      },
      {
        "path": "var/tmp/sub/b.bin",
        "type": "file",
        "content_utf8": "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"
      },
      {
        "path": "var/uploads/a.bin",
        "type": "file",
        "content_utf8": ""
      },
      {
        "path": "var/uploads/sub/b.bin",
        "type": "file",
        "content_utf8": ""
      }
    ]
  },
  "expect": {
    "answer": {
      "contains": [
        "uploads"
      ],
      "not_contains": [
        "cache",
        "logs",
        "tmp"
      ]
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "list \"var\" type: directory |> select name (find path type: file |> summarize sum(size)) |> sort sum order: desc |> first 1",
  "reference_bash": "for d in var/*/; do printf '%s %s\\n' \"$(find \"$d\" -type f -printf '%s\\n' | awk '{s+=$1} END {print s}')\" \"$d\"; done | sort -rn | head -n 1\n",
  "reference_pwsh": "$py = if ($IsWindows) { 'python' } else { 'python3' }\nGet-ChildItem var -Directory | ForEach-Object { [pscustomobject]@{ Name = $_.Name; Size = (Get-ChildItem $_.FullName -Recurse -File | Measure-Object Length -Sum).Sum } } | Sort-Object Size -Descending | Select-Object -First 1 -ExpandProperty Name\n",
  "tags": [
    "disk-usage"
  ],
  "license": "CC-BY-4.0"
}
