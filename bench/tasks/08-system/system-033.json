{
  "format": "nurt-bench-task/1",
  "id": "system-033",
  "domain": 8,
  "split": "public",
  "platform": "linux",
  "nl": "Remove the write permission for others from every file under data/ that has it. Other permission bits stay unchanged. (set 1)",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "data/a.csv",
        "type": "file",
        "content_utf8": "content 0\n",
        "mode": "0666"
      },
      {
        "path": "data/b.csv",
        "type": "file",
        "content_utf8": "content 1\n",
        "mode": "0644"
      },
      {
        "path": "data/run.sh",
        "type": "file",
        "content_utf8": "content 3\n",
        "mode": "0777"
      },
      {
        "path": "data/sub/c.csv",
        "type": "file",
        "content_utf8": "content 2\n",
        "mode": "0664"
      }
    ]
  },
  "expect": {
    "files": {
      "data/a.csv": {
        "mode": "0664",
        "same_as_before": "data/a.csv"
      },
      "data/run.sh": {
        "mode": "0775",
        "same_as_before": "data/run.sh"
      }
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "find \"data\" type: file |> filter mode & \"0002\" |> attributes mode: \"o-w\"",
  "reference_bash": "find data -type f -perm -o+w -exec chmod o-w {} +\n",
  "tags": [
    "permissions"
  ],
  "license": "CC-BY-4.0"
}
