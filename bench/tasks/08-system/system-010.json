{
  "format": "nurt-bench-task/1",
  "id": "system-010",
  "domain": 8,
  "split": "public",
  "platform": "cross",
  "nl": "A tools/idle.py process with the argument report-builder-4 is running. What is its process ID?",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "run/.keep",
        "type": "file",
        "content_utf8": ""
      },
      {
        "path": "tools/idle.py",
        "type": "file",
        "content_utf8": "import time\n\nwhile True:\n    time.sleep(1)\n"
      }
    ]
  },
  "setup": {
    "description": "tools/idle.py report-builder-4 runs; its PID is recorded in run/app.pid for the oracle.",
    "bash": "setsid python3 tools/idle.py report-builder-4 > /dev/null 2>&1 < /dev/null &\necho $! > run/app.pid",
    "pwsh": "$py = if ($IsWindows) { 'python' } else { 'python3' }\n$p = Start-Process $py -ArgumentList 'tools/idle.py','report-builder-4' -PassThru\nSet-Content run/app.pid $p.Id"
  },
  "teardown": {
    "bash": "pkill -f -- report-builder-4 || true",
    "pwsh": "Get-Process | Where-Object { $_.CommandLine -like '*report-builder-4*' } | Stop-Process -Force -ErrorAction SilentlyContinue"
  },
  "expect": {
    "answer": {
      "regex": [
        "\\d+"
      ]
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle": {
    "script": "answer_from_file",
    "params": {
      "path": "run/app.pid"
    }
  },
  "oracle_program": "processes |> filter command ~ \"report-builder-4\" |> select pid",
  "reference_bash": "pgrep -f -- 'idle.py report-builder-4'\n",
  "reference_pwsh": "$py = if ($IsWindows) { 'python' } else { 'python3' }\n(Get-Process | Where-Object { $_.CommandLine -like '*idle.py report-builder-4*' }).Id\n",
  "tags": [
    "pid",
    "processes"
  ],
  "license": "CC-BY-4.0"
}
