{
  "format": "nurt-bench-task/1",
  "id": "structured-037",
  "domain": 4,
  "split": "public",
  "platform": "cross",
  "nl": "What is the total quantity of the rows in sales.csv whose product is bolt? Answer with the number.",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "sales.csv",
        "type": "file",
        "content_utf8": "date,region,product,quantity,amount\n2026-01-04,north,bolt,120,9.60\n2026-01-04,south,nut,300,9.00\n2026-01-05,north,hinge,4,9.60\n2026-01-06,east,bolt,75,6.00\n2026-01-06,south,washer,1000,10.00\n2026-01-07,north,nut,50,1.50\n2026-01-08,east,hinge,10,24.00\n2026-01-09,south,bolt,40,3.20\n"
      }
    ]
  },
  "expect": {
    "answer": {
      "regex": [
        "(?<![\\d.])235(?![\\d.])"
      ]
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "read \"sales.csv\" |> filter product == \"bolt\" |> summarize sum(quantity)",
  "reference_bash": "awk -F, 'NR > 1 && $3 == \"bolt\" { s += $4 } END { printf \"%d\\n\", s }' sales.csv\n",
  "reference_pwsh": "$s = (Import-Csv sales.csv | Where-Object product -eq 'bolt' | Measure-Object -Property quantity -Sum).Sum; $s\n",
  "tags": [
    "aggregate",
    "csv"
  ],
  "license": "CC-BY-4.0"
}
