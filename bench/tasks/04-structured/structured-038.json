{
  "format": "nurt-bench-task/1",
  "id": "structured-038",
  "domain": 4,
  "split": "public",
  "platform": "windows",
  "nl": "What is the total amount of the rows in sales.csv whose product is hinge? Answer with the number with two decimal places.",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "sales.csv",
        "type": "file",
        "content_utf8": "date,region,product,quantity,amount\r\n2026-01-04,north,bolt,120,9.60\r\n2026-01-04,south,nut,300,9.00\r\n2026-01-05,north,hinge,4,9.60\r\n2026-01-06,east,bolt,75,6.00\r\n2026-01-06,south,washer,1000,10.00\r\n2026-01-07,north,nut,50,1.50\r\n2026-01-08,east,hinge,10,24.00\r\n2026-01-09,south,bolt,40,3.20\r\n"
      }
    ]
  },
  "expect": {
    "answer": {
      "regex": [
        "(?<![\\d.])33\\.60(?![\\d])"
      ]
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "read \"sales.csv\" |> filter product == \"hinge\" |> summarize sum(amount)",
  "reference_pwsh": "$s = (Import-Csv sales.csv | Where-Object product -eq 'hinge' | Measure-Object -Property amount -Sum).Sum; '{0:F2}' -f $s\n",
  "tags": [
    "aggregate",
    "csv"
  ],
  "license": "CC-BY-4.0"
}
