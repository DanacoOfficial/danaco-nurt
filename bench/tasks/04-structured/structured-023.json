{
  "format": "nurt-bench-task/1",
  "id": "structured-023",
  "domain": 4,
  "split": "public",
  "platform": "cross",
  "nl": "In config/deploy.yaml set the image tag to 2.4.0. Other keys keep their values.",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": ".env.example",
        "type": "file",
        "content_utf8": "DATABASE_URL=postgres://db.example.com:5432/orders\nLOG_LEVEL=info\n"
      },
      {
        "path": "config/app.json",
        "type": "file",
        "content_utf8": "{\n  \"name\": \"orders\",\n  \"port\": 8080,\n  \"features\": {\n    \"export\": true,\n    \"beta_ui\": false\n  },\n  \"allowed_origins\": [\"https://example.com\"]\n}\n"
      },
      {
        "path": "config/db.toml",
        "type": "file",
        "content_utf8": "# Database settings\n[database]\nurl = \"postgres://db.example.com:5432/orders\"\npool_size = 10\ntimeout_seconds = 30\n\n[database.replica]\nurl = \"postgres://replica.example.com:5432/orders\"\nenabled = false\n"
      },
      {
        "path": "config/deploy.yaml",
        "type": "file",
        "content_utf8": "service: orders\nreplicas: 2\nimage: ghcr.io/example/orders:2.3.0\nresources:\n  memory: 512Mi\n  cpu: 500m\nenv:\n  LOG_LEVEL: info\n  REGION: eu-central\n"
      },
      {
        "path": "config/legacy.ini",
        "type": "file",
        "content_utf8": "[server]\nhost = 0.0.0.0\nport = 8080\ndebug = true\n\n[mail]\nsender = orders@example.com\nsmtp = smtp.example.com\n"
      }
    ]
  },
  "expect": {
    "files": {
      "config/deploy.yaml": {
        "regex": [
          "(?m)^image: ghcr\\.io/example/orders:2\\.4\\.0\\r?$"
        ],
        "contains": [
          "service: orders",
          "replicas: 2",
          "resources:",
          "  memory: 512Mi",
          "  cpu: 500m",
          "env:",
          "  LOG_LEVEL: info",
          "  REGION: eu-central"
        ],
        "not_contains": [
          "image: ghcr.io/example/orders:2.3.0\n"
        ]
      }
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "set \"config/deploy.yaml\" key: \"image\" value: \"ghcr.io/example/orders:2.4.0\"",
  "reference_bash": "sed -i 's|^image: ghcr.io/example/orders:2.3.0$|image: ghcr.io/example/orders:2.4.0|' config/deploy.yaml\n",
  "reference_pwsh": "$p = Join-Path $PWD 'config/deploy.yaml'; $t = [IO.File]::ReadAllText($p); [IO.File]::WriteAllText($p, ($t -creplace '(?m)^image: ghcr\\.io/example/orders:2\\.3\\.0(?=\\r?$)', 'image: ghcr.io/example/orders:2.4.0'))\n",
  "tags": [
    "yaml"
  ],
  "license": "CC-BY-4.0"
}
