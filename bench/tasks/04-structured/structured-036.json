{
  "format": "nurt-bench-task/1",
  "id": "structured-036",
  "domain": 4,
  "split": "public",
  "platform": "linux",
  "nl": "What is the total amount of the rows in sales.csv whose region is south? Answer with the number with two decimal places.",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "sales.csv",
        "type": "file",
        "content_utf8": "date,region,product,quantity,amount\n2026-01-04,north,bolt,120,9.60\n2026-01-04,south,nut,300,9.00\n2026-01-05,north,hinge,4,9.60\n2026-01-06,east,bolt,75,6.00\n2026-01-06,south,washer,1000,10.00\n2026-01-07,north,nut,50,1.50\n2026-01-08,east,hinge,10,24.00\n2026-01-09,south,bolt,40,3.20\n"
      }
    ]
  },
  "expect": {
    "answer": {
      "regex": [
        "(?<![\\d.])22\\.20(?![\\d])"
      ]
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "read \"sales.csv\" |> filter region == \"south\" |> summarize sum(amount)",
  "reference_bash": "awk -F, 'NR > 1 && $2 == \"south\" { s += $5 } END { printf \"%.2f\\n\", s }' sales.csv\n",
  "tags": [
    "aggregate",
    "csv"
  ],
  "license": "CC-BY-4.0"
}
