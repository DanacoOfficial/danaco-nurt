{
  "format": "nurt-bench-task/1",
  "id": "single-edit-022",
  "domain": 3,
  "split": "public",
  "platform": "cross",
  "nl": "Remove the entry of old.example.com from known_hosts. Keep all other lines in their order.",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "known_hosts",
        "type": "file",
        "content_utf8": "git.example.com ssh-ed25519 AAAAC3NzaC1\nold.example.com ssh-rsa AAAAB3Nza\nci.example.com ssh-ed25519 AAAAC3Nzb\n"
      }
    ]
  },
  "expect": {
    "files": {
      "known_hosts": {
        "text": "git.example.com ssh-ed25519 AAAAC3NzaC1\nci.example.com ssh-ed25519 AAAAC3Nzb\n"
      }
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "lines \"known_hosts\" |> filter text ~ \"old.example.com\" |> remove",
  "reference_bash": "sed -i '/old\\.example\\.com/d' known_hosts\n",
  "reference_pwsh": "$p = Join-Path $PWD 'known_hosts'; $t = [IO.File]::ReadAllText($p); $eol = if ($t.Contains(\"`r`n\")) { \"`r`n\" } else { \"`n\" }; $l = [IO.File]::ReadAllLines($p) | Where-Object { -not $_.Contains('old.example.com') }; [IO.File]::WriteAllText($p, ($l -join $eol) + $eol)\n",
  "tags": [
    "delete-lines"
  ],
  "license": "CC-BY-4.0"
}
