{
  "format": "nurt-bench-task/1",
  "id": "single-edit-049",
  "domain": 3,
  "split": "public",
  "platform": "cross",
  "nl": "Set PORT to 8000 in .env. Do not touch other variables, including those whose names start with PORT.",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": ".env",
        "type": "file",
        "content_utf8": "PORT=3000\nHOST=0.0.0.0\nPORT_ADMIN=3001\n"
      }
    ]
  },
  "expect": {
    "files": {
      ".env": {
        "text": "PORT=8000\nHOST=0.0.0.0\nPORT_ADMIN=3001\n"
      }
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "set \".env\" key: \"PORT\" value: \"8000\" format: env",
  "reference_bash": "sed -i 's/^PORT=.*/PORT=8000/' .env\n",
  "reference_pwsh": "$p = Join-Path $PWD '.env'; $t = [IO.File]::ReadAllText($p); [IO.File]::WriteAllText($p, ($t -creplace '(?m)^PORT=[^\\r\\n]*', 'PORT=8000'))\n",
  "negatives": [
    {
      "shell": "bash",
      "script": "sed -i 's/^PORT.*/PORT=8000/' .env",
      "defect": "also rewrites variables with a longer name"
    }
  ],
  "tags": [
    "env",
    "key-value"
  ],
  "license": "CC-BY-4.0"
}
