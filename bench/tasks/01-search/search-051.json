{
  "format": "nurt-bench-task/1",
  "id": "search-051",
  "domain": 1,
  "split": "public",
  "platform": "linux",
  "nl": "List the files under data/ that are empty (zero bytes).",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "data/a.txt",
        "type": "file",
        "content_utf8": "alpha\n"
      },
      {
        "path": "data/d.csv",
        "type": "file",
        "content_utf8": "x,y\n"
      },
      {
        "path": "data/empty-0.txt",
        "type": "file",
        "content_utf8": ""
      },
      {
        "path": "data/sub/b.txt",
        "type": "file",
        "content_utf8": "beta\n"
      },
      {
        "path": "data/sub/c.txt",
        "type": "file",
        "content_utf8": "\n"
      },
      {
        "path": "data/sub/zero.log",
        "type": "file",
        "content_utf8": ""
      }
    ]
  },
  "expect": {
    "answer": {
      "contains": [
        "empty-0.txt",
        "zero.log"
      ],
      "not_contains": [
        "a.txt",
        "b.txt",
        "c.txt",
        "d.csv"
      ]
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "find \"data\" type: file |> filter size == 0",
  "reference_bash": "find data -type f -empty\n",
  "tags": [
    "find",
    "size"
  ],
  "license": "CC-BY-4.0"
}
