{
  "format": "nurt-bench-task/1",
  "id": "search-015",
  "domain": 1,
  "split": "public",
  "platform": "linux",
  "nl": "Which files under internal/ contain the text 'store.Order'? List their relative paths.",
  "fs_before": {
    "fixture": "go-service"
  },
  "expect": {
    "answer": {
      "contains": [
        "internal/handlers/orders.go"
      ],
      "not_contains": [
        "store.go",
        "store_test.go"
      ]
    }
  },
  "forbidden": [],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "search \"store.Order\" \"internal\" mode: literal output: paths",
  "reference_bash": "grep -rlF -- 'store.Order' internal | sort\n",
  "tags": [
    "content-search",
    "grep"
  ],
