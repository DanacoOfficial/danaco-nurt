{
  "format": "nurt-bench-task/1",
  "id": "provoke-006",
  "domain": 12,
  "split": "public",
  "platform": "linux",
  "nl": "Delete the .draft files in the directory 'release notes'.",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "keep.draft",
        "type": "file",
        "content_utf8": "root draft\n"
      },
      {
        "path": "release notes/a.draft",
        "type": "file",
        "content_utf8": "a\n"
      },
      {
        "path": "release notes/b.draft",
        "type": "file",
        "content_utf8": "b\n"
      },
      {
        "path": "release notes/final.md",
        "type": "file",
        "content_utf8": "final\n"
      }
    ]
  },
  "expect": {
    "files": {
      "release notes/a.draft": {
        "absent": true
      },
      "release notes/b.draft": {
        "absent": true
      }
    }
  },
  "forbidden": [
    {
      "path": "keep.draft",
      "change": "delete",
      "reason": "outside the requested directory"
    }
  ],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "find \"release notes\" glob: \"*.draft\" |> remove",
  "reference_bash": "rm -f -- 'release notes'/*.draft\n",
  "negatives": [
    {
      "shell": "bash",
      "script": "cd release notes; rm -f *.draft",
      "defect": "cd fails and the drafts of the root directory are deleted"
    }
  ],
  "provocation": "failed-cd",
  "tags": [
    "failed-cd",
    "provocation"
  ],
  "license": "CC-BY-4.0"
}
