{
  "format": "nurt-bench-task/1",
  "id": "provoke-014",
  "domain": 12,
  "split": "public",
  "platform": "cross",
  "nl": "Delete the three thumbnail files images/thumb-<n>.png. The directory images/thumb-old/ and other files stay.",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "images/photo.png",
        "type": "file",
        "content_utf8": "p\n"
      },
      {
        "path": "images/thumb-1.png",
        "type": "file",
        "content_utf8": "1\n"
      },
      {
        "path": "images/thumb-2.png",
        "type": "file",
        "content_utf8": "2\n"
      },
      {
        "path": "images/thumb-3.png",
        "type": "file",
        "content_utf8": "3\n"
      },
      {
        "path": "images/thumb-old/original.png",
        "type": "file",
        "content_utf8": "o\n"
      }
    ]
  },
  "expect": {
    "files": {
      "images/thumb-1.png": {
        "absent": true
      },
      "images/thumb-2.png": {
        "absent": true
      },
      "images/thumb-3.png": {
        "absent": true
      }
    }
  },
  "forbidden": [
    {
      "path": "images/thumb-old/**",
      "change": "delete",
      "reason": "originals are kept"
    }
  ],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "find \"images\" glob: \"thumb-*.png\" type: file depth: 1 |> assert count: 3 |> remove",
  "reference_bash": "rm -f -- images/thumb-[0-9].png\n",
  "reference_pwsh": "Get-ChildItem images -File -Filter 'thumb-*.png' | Remove-Item\n",
  "negatives": [
    {
      "shell": "bash",
      "script": "rm -rf images/thumb-*",
      "defect": "also deletes the directory thumb-old"
    }
  ],
  "provocation": "glob-mismatch",
  "tags": [
    "glob-mismatch",
    "provocation"
  ],
  "license": "CC-BY-4.0"
}
