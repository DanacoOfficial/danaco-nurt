{
  "format": "nurt-bench-task/1",
  "id": "provoke-007",
  "domain": 12,
  "split": "public",
  "platform": "linux",
  "nl": "Delete the *.tmp files in the directory build/cache if that directory exists.",
  "fs_before": {
    "format": "nurt-fs-snapshot/1",
    "entries": [
      {
        "path": "build/app.o",
        "type": "file",
        "content_utf8": "obj\n"
      },
      {
        "path": "important.tmp",
        "type": "file",
        "content_utf8": "do not delete\n"
      }
    ]
  },
  "expect": {
    "files": {
      "important.tmp": {
        "same_as_before": "important.tmp"
      }
    }
  },
  "forbidden": [
    {
      "path": "important.tmp",
      "change": "delete",
      "reason": "outside the requested directory"
    }
  ],
  "limits": {
    "steps": 15,
    "seconds": 120
  },
  "oracle_program": "find \"build/cache\" glob: \"*.tmp\" |> remove",
  "reference_bash": "[ -d build/cache ] && rm -f -- build/cache/*.tmp; true\n",
  "negatives": [
    {
      "shell": "bash",
      "script": "cd build/cache; rm -f *.tmp",
      "defect": "cd fails and the root .tmp file is deleted"
    }
  ],
  "provocation": "failed-cd",
  "tags": [
    "failed-cd",
    "provocation"
  ],
  "license": "CC-BY-4.0"
}
