{
  "format": "nurt-fs-snapshot/1",
  "entries": [
    {
      "path": "etc/cron.d/backup",
      "type": "file",
      "content_utf8": "SHELL=/bin/sh\nPATH=/usr/sbin:/usr/bin:/sbin:/bin\n30 2 * * * root /usr/local/bin/backup --full\n"
    },
    {
      "path": "etc/hosts",
      "type": "file",
      "content_utf8": "127.0.0.1 localhost\n::1 localhost ip6-localhost\n203.0.113.5 db.internal.example.com db\n"
    },
    {
      "path": "etc/logrotate.d/orders",
      "type": "file",
      "content_utf8": "/var/log/orders/*.log {\n    daily\n    rotate 7\n    compress\n    missingok\n}\n"
    },
    {
      "path": "etc/passwd",
      "type": "file",
      "content_utf8": "root:x:0:0:root:/root:/bin/bash\ndaemon:x:1:1:daemon:/usr/sbin:/usr/sbin/nologin\norders:x:998:998:Orders service:/opt/orders:/usr/sbin/nologin\nuser:x:1000:1000:Example User:/home/user:/bin/bash\ndeploy:x:1001:1001:Deployment:/srv/deploy:/bin/bash\nbackup:x:34:34:backup:/var/backups:/usr/sbin/nologin\n"
    },
    {
      "path": "etc/ssh/sshd_config",
      "type": "file",
      "content_utf8": "Port 22\nPermitRootLogin yes\nPasswordAuthentication yes\nPubkeyAuthentication yes\nX11Forwarding no\nMaxAuthTries 6\nSubsystem sftp /usr/lib/openssh/sftp-server\n"
    },
    {
      "path": "etc/sysctl.d/90-net.conf",
      "type": "file",
      "content_utf8": "net.core.somaxconn = 1024\n"
    },
    {
      "path": "etc/systemd/system/orders.service",
      "type": "file",
      "content_utf8": "[Unit]\nDescription=Orders service\nAfter=network.target\n\n[Service]\nUser=orders\nExecStart=/opt/orders/bin/orders --port 8080\nRestart=on-failure\n\n[Install]\nWantedBy=multi-user.target\n"
    },
    {
      "path": "etc/systemd/system/reports.service",
      "type": "file",
      "content_utf8": "[Unit]\nDescription=Report generator\n\n[Service]\nType=oneshot\nExecStart=/opt/reports/bin/generate\n"
    }
  ]
}
