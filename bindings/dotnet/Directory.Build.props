<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Features>strict</Features>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en</NeutralLanguage>
    <Authors>Danaco Holding Group Sp. z o.o.</Authors>
    <Company>Danaco Holding Group Sp. z o.o.</Company>
    <Product>Danaco Nurt</Product>
    <Copyright>Copyright 2026 Danaco Holding Group Sp. z o.o.</Copyright>
    <Version Condition="'$(Version)' == ''">0.1.1</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
