<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Danaco.Nurt</RootNamespace>
    <AssemblyName>Danaco.Nurt</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Danaco.Nurt</PackageId>
    <Title>Danaco Nurt</Title>
    <Description>Command shell and language where every change can be undone</Description>
    <PackageTags>nurt;console;shell;automation;mcp</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://nurt.danaco-group.pl</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/DanacoOfficial/nurt</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <PropertyGroup>
    <NurtNativeDir Condition="'$(NurtNativeDir)' == ''">$(MSBuildThisFileDirectory)../../artifacts/native/</NurtNativeDir>
    <NurtNativeDir>$([MSBuild]::EnsureTrailingSlash('$(NurtNativeDir)'))</NurtNativeDir>
    <NurtRequireNative Condition="'$(NurtRequireNative)' == ''">false</NurtRequireNative>
    <NurtRuntimeIdentifiers>linux-x64;linux-arm64;linux-musl-x64;osx-x64;osx-arm64;win-x64;win-arm64</NurtRuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <Compile Remove="Interop/NativeMethods.DllImport.cs" />
    <Compile Remove="Internal/Polyfills.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="Interop/NativeMethods.LibraryImport.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Danaco.Nurt.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" Visible="false" />
    <None Include="../../../../LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="../../../../NOTICE" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(NurtNativeDir)**/*" Pack="true" PackagePath="runtimes/%(RecursiveDir)native/" Visible="false" />
  </ItemGroup>

  <Target Name="ValidateNurtNativeAssets" BeforeTargets="GenerateNuspec" Condition="'$(NurtRequireNative)' == 'true'">
    <ItemGroup>
      <_NurtRid Include="$(NurtRuntimeIdentifiers)" />
      <_NurtMissing Include="@(_NurtRid)" Condition="!Exists('$(NurtNativeDir)%(Identity)/nurt') And !Exists('$(NurtNativeDir)%(Identity)/nurt.exe')" />
      <_NurtMissing Include="@(_NurtRid)" Condition="!Exists('$(NurtNativeDir)%(Identity)/libnurt.so') And !Exists('$(NurtNativeDir)%(Identity)/libnurt.dylib') And !Exists('$(NurtNativeDir)%(Identity)/nurt.dll')" />
    </ItemGroup>
    <Error Condition="'@(_NurtMissing)' != ''" Text="native assets missing for runtime identifiers: @(_NurtMissing->Distinct()); place nurt and libnurt under $(NurtNativeDir)&lt;rid&gt;/" />
  </Target>

</Project>
