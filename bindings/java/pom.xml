<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>pl.danaco-group</groupId>
  <artifactId>nurt-parent</artifactId>
  <version>0.1.1</version>
  <packaging>pom</packaging>

  <name>Danaco Nurt for Java (parent)</name>
  <description>Command shell and language where every change can be undone</description>
  <url>https://nurt.danaco-group.pl</url>

  <organization>
    <name>Danaco Holding Group Sp. z o.o.</name>
    <url>https://www.danaco-group.pl</url>
  </organization>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <organization>Danaco Holding Group Sp. z o.o.</organization>
      <email>support@danaco-group.pl</email>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/DanacoOfficial/danaco-nurt</url>
    <connection>scm:git:https://github.com/DanacoOfficial/danaco-nurt.git</connection>
  </scm>

  <modules>
    <module>nurt</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <conformance.bindings>${maven.multiModuleProjectDirectory}/../../conformance/bindings</conformance.bindings>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${maven.multiModuleProjectDirectory}/../..</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>NOTICE</include>
        </includes>
      </resource>
    </resources>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <compilerArgs>
              <arg>-Xlint:all</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
          <configuration>
            <useModulePath>false</useModulePath>
            <systemPropertyVariables>
              <nurt.conformance.bindings>${conformance.bindings}</nurt.conformance.bindings>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <profile>
      <id>ffm</id>
      <activation>
        <jdk>[22,)</jdk>
      </activation>
      <modules>
        <module>nurt-ffm</module>
      </modules>
    </profile>
  </profiles>
</project>

