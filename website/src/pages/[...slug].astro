// Module:           website.src.pages.slug
// Responsibility:   The authored pages of the site in English: one route per entry of the pages collection.
// Dependencies:     website.src.components.pages.ContentPage, website.src.lib.pages

import ContentPage from '../components/pages/ContentPage.astro';
import { getPages, pageSlug } from '../lib/pages';

export async function getStaticPaths() {
  const entries = await getPages('en');
  return entries.map((entry) => ({ params: { slug: pageSlug(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
---

<ContentPage entry={entry} locale="en" />
