// Module:           website.src.layouts.BaseLayout
// Responsibility:   The document of every page: the head with the metadata, fonts and icons, the skip link, the header, the main region and the footer.
// Dependencies:     website.src.components.layout.*, website.src.styles.global, website.src.scripts.theme-init, website.src.scripts.motion-init, website.src.scripts.motion, website.config.theme

import '../styles/global.css';
import themeInit from '../scripts/theme-init.ts?raw';
import motionInit from '../scripts/motion-init.ts?raw';
import localeInit from '../scripts/locale-init.ts?raw';
import geistFont from '../assets/fonts/geist-variable.woff2?url';
import geistMonoFont from '../assets/fonts/geist-mono-variable.woff2?url';
import { localeSettings, locales, type Locale } from '../../config/i18n';
import { seo } from '../../config/seo';
import Seo from '../components/layout/Seo.astro';
import SkipLink from '../components/layout/SkipLink.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { href, withBase } from '../lib/urls';
import { useUi } from '../i18n';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  path: string;
  available?: Locale[];
  type?: 'website' | 'article';
  noindex?: boolean;
  home?: boolean;
  breadcrumbs?: { label: string; path: string }[];
  searchable?: boolean;
  context?: string;
}

const { title, description, locale, path, available = [...locales], type, noindex, home, breadcrumbs, searchable = true, context } = Astro.props;
const ui = useUi(locale);
const polishHref = locale === 'en' && available.includes('pl') ? href(path, 'pl') : undefined;
---

<!doctype html>
<html
  lang={localeSettings[locale].htmlLang}
  data-label-copy={ui.common.copy}
  data-label-copied={ui.common.copied}
  data-label-copy-failed={ui.common.copyFailed}
  data-pl-href={polishHref}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content={seo.themeColor.dark} media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content={seo.themeColor.light} media="(prefers-color-scheme: light)" />
    <meta name="generator" content="Astro" />
    <Seo title={title} description={description} locale={locale} path={path} available={available} type={type} noindex={noindex} home={home} breadcrumbs={breadcrumbs} context={context} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="48x48" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <link rel="preload" href={geistFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoFont} as="font" type="font/woff2" crossorigin />
    {polishHref && <script is:inline set:html={localeInit}></script>}
    <script is:inline set:html={themeInit}></script>
    <script is:inline set:html={motionInit}></script>
    <noscript>
      <style is:inline>
        .site-header__panel { display: block; max-height: none; }
        .site-header__menu-button { display: none; }
      </style>
    </noscript>
  </head>
  <body>
    <SkipLink locale={locale} />
    <Header locale={locale} path={path} available={available} />
    <main id="page-content" tabindex="-1" data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import { startMotion } from '../scripts/motion';
      import { fitTables, labelTableCells, protectCode } from '../scripts/page-content';
      protectCode();
      labelTableCells();
      fitTables();
      startMotion();
    </script>
  </body>
</html>
