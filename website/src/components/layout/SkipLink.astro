// Module:           website.src.components.layout.SkipLink
// Responsibility:   The first focusable link of every page: it moves the keyboard focus to the content.
// Dependencies:     website.src.i18n, website.src.styles.components.skip-link

import '../../styles/components/skip-link.css';
import { useUi } from '../../i18n';
import type { Locale } from '../../../config/i18n';

interface Props {
  locale: Locale;
}

const ui = useUi(Astro.props.locale);
---

<a class="skip-link" href="#page-content">{ui.skipToContent}</a>
