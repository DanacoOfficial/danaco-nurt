// Module:           website.src.components.content.Card
// Responsibility:   A card with an icon, a title, a text and an optional link; the cut corners of the identity mark the card as a unit.
// Dependencies:     website.src.components.base.Icon, website.src.styles.components.cards

import '../../styles/components/cards.css';
import Icon from '../base/Icon.astro';
import type { IconName } from '../../../config/icons';
import { withBase } from '../../lib/urls';
interface Props {
  title: string;
  href?: string;
  icon?: IconName;
  eyebrow?: string;
}
const { title, href, icon, eyebrow } = Astro.props;
const link = href && href.startsWith('/') ? withBase(href) : href;
const Tag = link ? 'a' : 'div';
---

<Tag class:list={['card', link && 'card--link']} href={link}>
  {icon && <Icon name={icon} size={22} class="card__icon" />}
  {eyebrow && <p class="card__eyebrow">{eyebrow}</p>}
  <h3 class="card__title">{title}</h3>
  <div class="card__body"><slot /></div>
  {link && <Icon name="arrow-right" size={20} class="card__arrow" />}
</Tag>
