//
// Module:           website.src.components.content.Stat
// Responsibility:   One measured figure with its label and the source of the number.
// Dependencies:     website.src.styles.components.stats

import '../../styles/components/stats.css';
interface Props {
  value: string;
  label: string;
  source?: string;
  href?: string;
}
const { value, label, source, href } = Astro.props;
---

<div class="stat">
  <p class="stat__value">{value}</p>
  <p class="stat__label">{label}</p>
  {source && (href ? <p class="stat__source"><a href={href} rel="noopener">{source}</a></p> : <p class="stat__source">{source}</p>)}
</div>
