// Module:           website.src.components.content.Ledger
// Responsibility:   A list of linked entries drawn as ruled rows with a numeral, a title, a one-line text and an arrow, in one or two columns; it replaces the walls of cards for lists of pages.
// Dependencies:     website.src.components.base.Icon, website.src.lib.urls, website.src.styles.components.ledger

import '../../styles/components/ledger.css';
import Icon from '../base/Icon.astro';
import { withBase } from '../../lib/urls';

interface Item {
  title: string;
  text?: string;
  href: string;
  meta?: string;
}
interface Props {
  items: Item[];
  columns?: 1 | 2;
  start?: number;
}
const { items, columns = 1, start = 1 } = Astro.props;
const link = (href: string): string => (href.startsWith('/') ? withBase(href) : href);
---

<ol class:list={['ledger', columns === 2 && 'ledger--2']} role="list">
  {items.map((item, index) => (
    <li>
      <a class="ledger__row" href={link(item.href)}>
        <span class="ledger__index" aria-hidden="true">{String(index + start).padStart(2, '0')}</span>
        <span class="ledger__text">
          <strong>{item.title}</strong>
          {item.text && <span>{item.text}</span>}
        </span>
        {item.meta && <span class="ledger__meta">{item.meta}</span>}
        <Icon name="arrow-right" size={16} />
      </a>
    </li>
  ))}
</ol>
