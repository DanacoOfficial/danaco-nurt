// Module:           website.src.components.content.Fact
// Responsibility:   One number of the site, taken from the facts module by its identifier, with its label and its source in the language of the page.
// Dependencies:     website.src.data.facts, website.src.lib.urls, website.src.components.content.Stat

import Stat from './Stat.astro';
import { facts, type FactId } from '../../data/facts';
import { logicalPath, href } from '../../lib/urls';

interface Props {
  id: FactId;
}

const { id } = Astro.props;
const { locale } = logicalPath(Astro.url.pathname);
const fact = facts[id];
if (!fact) {
  throw new Error(`unknown fact: ${id}`);
}
// Polish separates thousands with a no-break space, English with a comma.
const value = locale === 'pl' ? fact.value.replace(/(\d),(?=\d{3})/g, '$1\u00a0') : fact.value;
---

<Stat value={value} label={fact.label[locale]} source={fact.source[locale]} href={fact.href ? href(fact.href, locale) : undefined} />
