// Module:           website.src.components.content.Step
// Responsibility:   One step of a numbered sequence with a title and a body.
// Dependencies:     website.src.styles.components.steps

import '../../styles/components/steps.css';
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<li class="step">
  <h3 class="step__title">{title}</h3>
  <div class="step__body"><slot /></div>
</li>
