// Module:           website.src.components.content.BrandImage
// Responsibility:   An image from the brand assets (renders and mockups of the identity), optimised to WebP at build time, with an optional caption.
// Dependencies:     astro:assets, website.src.styles.components.figure

import '../../styles/components/figure.css';
import { Image } from 'astro:assets';

interface Props {
  name: string;
  alt: string;
  width?: number;
  caption?: string;
}

// Only the images a page shows are listed: every matched file is written to the output in full size.
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/brand/**/{mockup-business-card,mockup-docs-header-dark,mockup-terminal-banner,render-hero-front,render-light-ground,render-macro-edge}.webp',
  { eager: true },
);
const { name, alt, width = 1200, caption } = Astro.props;
const key = Object.keys(images).find((candidate) => candidate.endsWith(`/${name}.webp`));
if (!key) {
  throw new Error(`unknown brand image: ${name}; add the name to the list of BrandImage.astro`);
}
---

<figure class="figure">
  <Image src={images[key].default} alt={alt} width={width} widths={[width / 2, width]} sizes={`(min-width: 60rem) ${width}px, 100vw`} loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
