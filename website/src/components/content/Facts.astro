// Module:           website.src.components.content.Facts
// Responsibility:   A list of facts as terms and values; the rows come from the items property.
// Dependencies:     website.src.styles.components.facts

import '../../styles/components/facts.css';
interface Props {
  items: { term: string; value: string; href?: string }[];
}
const { items } = Astro.props;
---

<dl class="facts">
  {items.map((item) => (
    <div class="facts__row">
      <dt>{item.term}</dt>
      <dd>{item.href ? <a href={item.href}>{item.value}</a> : item.value}</dd>
    </div>
  ))}
</dl>
