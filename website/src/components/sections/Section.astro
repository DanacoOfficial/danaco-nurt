// Module:           website.src.components.sections.Section
// Responsibility:   A band of a page with its own heading: the eyebrow, the title, the lead and the content in the slot.
// Dependencies:     website.src.styles.layout

import '../../styles/components/ledger.css';

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  lead?: string;
  tone?: 'plain' | 'raised';
  tight?: boolean;
  split?: boolean;
}
const { id, eyebrow, title, lead, tone = 'plain', tight = false, split = false } = Astro.props;
---

<section id={id} class:list={['section', tight && 'section--tight', tone === 'raised' && 'section--raised', split && 'section--split']} aria-labelledby={title && id ? `${id}-title` : undefined}>
  <div class="container">
    <div class:list={[split && 'section__layout']}>
      {(eyebrow || title || lead) && (
        <div class="section__head stack" style={split ? '--stack-gap: var(--space-3);' : '--stack-gap: var(--space-3); margin-bottom: var(--space-7); max-width: 46rem;'}>
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {title && <h2 id={id ? `${id}-title` : undefined}>{title}</h2>}
          {lead && <p class="lead">{lead}</p>}
        </div>
      )}
      <div class:list={[split && 'section__body']}><slot /></div>
    </div>
  </div>
</section>
