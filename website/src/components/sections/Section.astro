// Module:           website.src.components.sections.Section
// Responsibility:   A part of a page on the ground of the page with its own heading: the eyebrow, the title, the lead and the content in the slot.
// Dependencies:     website.src.styles.layout

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  lead?: string;
  tight?: boolean;
  /** On a wide window the lead stands right of the title instead of under it. */
  split?: boolean;
}
const { id, eyebrow, title, lead, tight = false, split = true } = Astro.props;
---

<section id={id} class:list={['section', tight && 'section--tight']} aria-labelledby={title && id ? `${id}-title` : undefined}>
  <div class="container">
    {(eyebrow || title || lead) && (
      <div class:list={['section__head', split && lead && 'section__head--split']}>
        <div class="section__title stack" style="--stack-gap: var(--space-3);">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {title && <h2 id={id ? `${id}-title` : undefined}>{title}</h2>}
        </div>
        {lead && <p class="lead">{lead}</p>}
      </div>
    )}
    <slot />
  </div>
</section>
