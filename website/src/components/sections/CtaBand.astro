// Module:           website.src.components.sections.CtaBand
// Responsibility:   The closing band of a page: a sentence and the actions that follow it.
// Dependencies:     website.src.styles.components.cta-band

import '../../styles/components/cta-band.css';
interface Props {
  title: string;
  text?: string;
}
const { title, text } = Astro.props;
---

<section class="cta-band stream-trace">
  <div class="container cta-band__inner">
    <div class="cta-band__text">
      <h2>{title}</h2>
      {text && <p class="lead">{text}</p>}
    </div>
    <div class="cluster cta-band__actions"><slot /></div>
  </div>
</section>
