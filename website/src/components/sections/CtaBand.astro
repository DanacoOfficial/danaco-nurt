// Module:           website.src.components.sections.CtaBand
// Responsibility:   The closing call to action of a page: a framed panel with a sentence and the actions that follow it.
// Dependencies:     website.src.styles.components.cta-band

import '../../styles/components/cta-band.css';
interface Props {
  title: string;
  text?: string;
}
const { title, text } = Astro.props;
---

<section class="cta-band">
  <div class="container">
    <div class="cta-band__inner stream-trace">
      <div class="cta-band__text">
        <h2>{title}</h2>
        {text && <p class="lead">{text}</p>}
      </div>
      <div class="cluster cta-band__actions"><slot /></div>
    </div>
  </div>
</section>
