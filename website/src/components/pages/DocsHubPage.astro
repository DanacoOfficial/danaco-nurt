// Module:           website.src.components.pages.DocsHubPage
// Responsibility:   The documentation hub in one language: the start panel with the first steps and the installation, then four bands (learn, reference, build on Nurt, the project), each a list of rows for the documentation sections with their page counts.
// Dependencies:     website.src.layouts.BaseLayout, website.src.components.sections.PageHeader, website.src.components.sections.InstallTabs, website.src.lib.docs.model, website.src.styles.components.docs-hub

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../sections/PageHeader.astro';
import InstallTabs from '../sections/InstallTabs.astro';
import Icon from '../base/Icon.astro';
import Button from '../base/Button.astro';
import type { Locale } from '../../../config/i18n';
import { getDocs, groupDocs, entryUrl } from '../../lib/docs/model';
import { href } from '../../lib/urls';
import { pageCountLabel, useUi } from '../../i18n';
import { localizedDocs } from '../../lib/docs/localized';
import type { IconName } from '../../../config/icons';
import '../../styles/components/docs-hub.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = useUi(locale);
const groups = groupDocs(await getDocs());
const localized = await localizedDocs(locale);
const labels = ui.docs.sectionLabels as Record<string, string>;
const leads = ui.docs.sectionLeads as Record<string, string>;
const icons: Record<string, IconName> = {
  guide: 'rocket',
  guides: 'book-open',
  cookbook: 'flask-conical',
  commands: 'terminal',
  groups: 'layers',
  cheatsheets: 'list-checks',
  reference: 'braces',
  integrators: 'plug',
  architectureDocs: 'workflow',
  cli: 'terminal',
  providers: 'package',
  conventions: 'clipboard-check',
  specification: 'library',
};

const bandPlan: { key: 'learn' | 'reference' | 'build' | 'project'; keys: string[] }[] = [
  { key: 'learn', keys: ['guide', 'guides', 'cookbook', 'cheatsheets'] },
  { key: 'reference', keys: ['commands', 'groups', 'reference', 'specification'] },
  { key: 'build', keys: ['integrators', 'cli', 'providers'] },
  { key: 'project', keys: ['architectureDocs', 'conventions'] },
];
const placed = new Set(bandPlan.flatMap((band) => band.keys));
const bands = bandPlan.map((band) => ({
  ...band,
  groups: band.keys.map((key) => groups.find((group) => group.labelKey === key)).filter((group) => group !== undefined),
}));
const leftover = groups.filter((group) => !placed.has(group.labelKey));
if (leftover.length > 0) {
  bands[bands.length - 1]?.groups.push(...leftover);
}
const guide = groups.find((group) => group.labelKey === 'guide');
const firstSteps = (guide?.entries ?? []).filter((entry) => entryUrl(entry).replace(/\/$/, '') !== '/docs/guide').slice(0, 5);
const hub = ui.docs.hub;
---

<BaseLayout title={ui.docs.title} description={ui.docs.lead} locale={locale} path="/docs/" breadcrumbs={[{ label: ui.docs.title, path: '/docs/' }]}>
  <PageHeader locale={locale} title={ui.docs.title} lead={ui.docs.lead} eyebrow="Danaco Nurt" crumbs={[{ label: ui.docs.title }]}>
    <div class="cluster">
      <Button href={href('/docs/guide/installation/', locale)} variant="primary" iconAfter="arrow-right">{ui.docs.sectionLabels.guide}</Button>
      <Button href={href('/search/', locale)} variant="secondary" icon="search">{ui.nav.search}</Button>
    </div>
  </PageHeader>
  <div class="container docs-hub">
    <section class="docs-hub__start" aria-labelledby="docs-start">
      <div class="docs-hub__start-copy">
        <p class="docs-hub__eyebrow">{hub.startEyebrow}</p>
        <h2 id="docs-start">{hub.startTitle}</h2>
        <p class="docs-hub__lead">{hub.startLead}</p>
        <InstallTabs locale={locale} id="docs-install" />
      </div>
      <nav class="docs-hub__steps" aria-label={hub.startSteps}>
        <p class="docs-hub__steps-title">{hub.startSteps}</p>
        <ol>
          {firstSteps.map((entry, index) => (
            <li>
              <a href={href(entryUrl(entry), locale)}>
                <span class="docs-hub__step-index" aria-hidden="true">{index + 1}</span>
                <span>{localized.title(entry)}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </section>
    {bands.map((band) => (
      <section class="docs-hub__band" aria-labelledby={`docs-band-${band.key}`}>
        <header class="docs-hub__band-head">
          <h2 id={`docs-band-${band.key}`}>{hub.bands[band.key].title}</h2>
          <p>{hub.bands[band.key].lead}</p>
        </header>
        <ul class="docs-hub__rows" role="list">
          {band.groups.map((group) => (
            <li>
              <a class="docs-hub__row" href={href(`/docs/${group.section}/`, locale)}>
                <Icon name={icons[group.labelKey] ?? 'book-open'} size={20} />
                <span class="docs-hub__row-text">
                  <strong>{labels[group.labelKey] ?? group.section}</strong>
                  <span>{leads[group.labelKey]}</span>
                </span>
                <span class="docs-hub__row-count">{group.entries.length} {pageCountLabel(group.entries.length, locale)}</span>
                <Icon name="arrow-right" size={16} />
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
