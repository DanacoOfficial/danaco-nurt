//
// Module:           website.src.components.pages.NotFoundPage
// Responsibility:   The page for an address that does not exist, in both languages of the site, with ways back to the home page, the documentation and the search beside the sections of the site. The page shows both languages without scripts; with scripts it keeps the language of the address.
// Dependencies:     website.src.layouts.BaseLayout, website.src.components.base.Button, website.src.components.brand.Mark, website.src.components.sections.SiteSections

import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../base/Button.astro';
import Mark from '../brand/Mark.astro';
import SiteSections from '../sections/SiteSections.astro';
import type { Locale } from '../../../config/i18n';
import { href } from '../../lib/urls';
import { useUi } from '../../i18n';
import '../../styles/components/not-found.css';

const locales: readonly Locale[] = ['en', 'pl'];
const selectLanguage = "(function(){var pl=/^\\/pl(\\/|$)/.test(location.pathname);var keep=pl?'pl':'en';document.documentElement.lang=keep;var parts=document.querySelectorAll('[data-not-found]');for(var i=0;i<parts.length;i++){parts[i].hidden=parts[i].getAttribute('data-not-found')!==keep;}})();";
const en = useUi('en');
---

<BaseLayout title={en.notFound.title} description={en.notFound.lead} locale="en" path="/404/" noindex={true} available={['en']} searchable={false}>
  <div class="container not-found">
    {locales.map((locale) => {
      const ui = useUi(locale);
      return (
        <div class="split-page not-found__language" data-not-found={locale} lang={locale}>
          <div class="not-found__message">
            <Mark size={96} />
            <p class="eyebrow">404</p>
            {locale === 'en' ? <h1>{ui.notFound.title}</h1> : <h2 class="not-found__title">{ui.notFound.title}</h2>}
            <p class="lead">{ui.notFound.lead}</p>
            <div class="cluster">
              <Button href={href('/', locale)} variant="primary">{ui.notFound.home}</Button>
              <Button href={href('/docs/', locale)} variant="secondary">{ui.notFound.docs}</Button>
              <Button href={href('/search/', locale)} variant="quiet">{ui.notFound.search}</Button>
            </div>
          </div>
          <SiteSections locale={locale} />
        </div>
      );
    })}
  </div>
  <script is:inline set:html={selectLanguage} />
</BaseLayout>
