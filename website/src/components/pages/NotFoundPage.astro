// Module:           website.src.components.pages.NotFoundPage
// Responsibility:   The page for an address that does not exist, in both languages of the site, with ways back to the home page, the documentation and the search beside the sections of the site. The English page is the answer of the server for every missing address and carries both languages for a browser without scripts; with scripts it shows English, and under a Polish address it opens the Polish page, which then puts the address that was asked for back in the address bar. The Polish page is a page of its own, so its header, its footer and its scripts are those of every Polish page. It carries Polish only.
// Dependencies:     website.src.layouts.BaseLayout, website.src.components.base.Button, website.src.components.brand.Mark, website.src.components.sections.SiteSections

import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../base/Button.astro';
import Mark from '../brand/Mark.astro';
import SiteSections from '../sections/SiteSections.astro';
import type { Locale } from '../../../config/i18n';
import { href } from '../../lib/urls';
import { useUi } from '../../i18n';
import '../../styles/components/not-found.css';

interface Props {
  locale?: Locale;
}

const { locale: pageLocale = 'en' } = Astro.props;
const shown: readonly Locale[] = pageLocale === 'en' ? ['en', 'pl'] : ['pl'];
const polishPage = href('/404/', 'pl');
const selectLanguage = `(function(){var parts=document.querySelectorAll('[data-not-found]');for(var i=0;i<parts.length;i++){parts[i].hidden=parts[i].getAttribute('data-not-found')!=='en';}if(/^\\/pl(\\/|$)/.test(location.pathname)){document.documentElement.style.visibility='hidden';location.replace(${JSON.stringify(polishPage)}+'#'+encodeURIComponent(location.pathname+location.search));}})();`;
const restoreAddress = `(function(){try{var asked=decodeURIComponent(location.hash.slice(1));if(/^\\/pl\\/[^/]/.test(asked)){history.replaceState(null,'',asked);}}catch(error){}})();`;
const ui = useUi(pageLocale);
---

<BaseLayout title={ui.notFound.title} description={ui.notFound.lead} locale={pageLocale} path="/404/" noindex={true} available={[pageLocale]} searchable={false}>
  <div class="container not-found">
    {shown.map((locale) => {
      const text = useUi(locale);
      return (
        <div class="split-page not-found__language" data-not-found={pageLocale === 'en' ? locale : undefined} lang={locale}>
          <div class="not-found__message">
            <Mark size={96} />
            <p class="eyebrow">404</p>
            {locale === pageLocale ? <h1>{text.notFound.title}</h1> : <h2 class="not-found__title">{text.notFound.title}</h2>}
            <p class="lead">{text.notFound.lead}</p>
            <div class="cluster">
              <Button href={href('/', locale)} variant="primary">{text.notFound.home}</Button>
              <Button href={href('/docs/', locale)} variant="secondary">{text.notFound.docs}</Button>
              <Button href={href('/search/', locale)} variant="quiet">{text.notFound.search}</Button>
            </div>
          </div>
          <SiteSections locale={locale} />
        </div>
      );
    })}
  </div>
  <script is:inline set:html={pageLocale === 'en' ? selectLanguage : restoreAddress} />
</BaseLayout>
