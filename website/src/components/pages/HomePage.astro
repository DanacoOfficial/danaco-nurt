// Module:           website.src.components.pages.HomePage
// Responsibility:   The home page in one language: the hero, the pillars, the statement of the creator, how a program runs, the section for AI labs and agent engines, the numbers, the quality entry points, the design entry points, the documentation entry points and the closing call to action.
// Dependencies:     website.src.layouts.BaseLayout, website.src.components.sections.*, website.src.components.content.*, website.src.components.motion.*, website.src.data.home-page.*

import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import Section from '../sections/Section.astro';
import Statement from '../sections/Statement.astro';
import FeatureTour from '../sections/FeatureTour.astro';
import Directory from '../sections/Directory.astro';
import CtaBand from '../sections/CtaBand.astro';
import Icon from '../base/Icon.astro';
import TerminalSession from '../motion/TerminalSession.astro';
import Terminal from '../content/Terminal.astro';
import Fact from '../content/Fact.astro';
import Stats from '../content/Stats.astro';
import Button from '../base/Button.astro';
import type { Locale } from '../../../config/i18n';
import { seo } from '../../../config/seo';
import { site } from '../../../config/site';
import { homeEn } from '../../data/home-page/en';
import { homePl } from '../../data/home-page/pl';
import { href } from '../../lib/urls';
import { useUi } from '../../i18n';
import '../../styles/components/how.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = useUi(locale);
const content = locale === 'pl' ? homePl : homeEn;
---

<BaseLayout title="Danaco Nurt" description={seo.descriptions[locale]} locale={locale} path="/" home={true} context={ui.siteDescription}>
  <Hero locale={locale} content={content.hero} />

  <Section id="why" eyebrow={content.pillars.eyebrow} title={content.pillars.title} lead={content.pillars.lead}>
    <FeatureTour locale={locale} id="why" label={content.pillars.title} items={content.pillars.cards} />
  </Section>

  <Statement eyebrow={content.statement.eyebrow} quote={content.statement.quote} name={site.creator} role={content.statement.role} />

  <Section id="how" tone="raised" split={false} eyebrow={content.how.eyebrow} title={content.how.title} lead={content.how.lead}>
    <div class="how__program">
      <Terminal title={content.how.programTitle}>
        <pre><code class="language-nurt">{content.how.program}</code></pre>
      </Terminal>
    </div>
    <div class="how">
      <ol class="how__points" role="list">
        {content.how.points.map((point, index) => (
          <li class="how__point">
            <span class="how__index" aria-hidden="true">{index + 1}</span>
            <div>
              <h3>{point.title}</h3>
              <p class="text-muted">{point.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="how__terminals">
        <TerminalSession title={content.how.sessionTitle} replayLabel={content.how.sessionReplay} caption={content.how.sessionCaption} />
      </div>
    </div>
  </Section>

  <Section id="ai" eyebrow={content.ai.eyebrow} title={content.ai.title} lead={content.ai.lead}>
    <Stats>
      <Fact id="trainingPairs" />
      <Fact id="benchTasks" />
      <Fact id="toolFormats" />
      <Fact id="integrationExamples" />
    </Stats>
    <ul class="directory__list directory__list--pairs" role="list">
      {content.ai.cards.map((card) => (
        <li>
          <a class="directory__link" href={href(card.path, locale)}>
            <Icon name={card.icon} size={20} />
            <span class="directory__text">
              <span class="directory__name">{card.title}</span>
              <span class="directory__note">{card.text}</span>
            </span>
            <Icon name="arrow-right" size={16} class="directory__arrow" />
          </a>
        </li>
      ))}
    </ul>
    <div class="cluster">
      <Button href={href('/ai/overview/', locale)} variant="primary" iconAfter="arrow-right">{content.ai.action}</Button>
    </div>
  </Section>

  <Section id="numbers" tone="raised" eyebrow={content.numbers.eyebrow} title={content.numbers.title} lead={content.numbers.lead}>
    <Stats>
      <Fact id="commands" />
      <Fact id="platforms" />
      <Fact id="tests" />
      <Fact id="gitComparisons" />
      <Fact id="crates" />
      <Fact id="license" />
    </Stats>
  </Section>

  <Section id="explore">
    <Directory
      locale={locale}
      columns={[
        { id: 'quality', path: '/quality/', ...content.quality },
        { id: 'design', path: '/design/', ...content.design },
        { id: 'docs', path: '/docs/', ...content.docs },
      ]}
    />
  </Section>

  <CtaBand title={content.cta.title} text={content.cta.text}>
    <Button href={href('/docs/guide/installation/', locale)} variant="primary" iconAfter="arrow-right">{content.cta.primary}</Button>
    <Button href={href('/docs/guide/first-steps/', locale)} variant="secondary">{content.cta.secondary}</Button>
  </CtaBand>
  <p class="visually-hidden">{ui.siteDescription}</p>
</BaseLayout>
