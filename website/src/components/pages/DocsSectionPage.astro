// Module:           website.src.components.pages.DocsSectionPage
// Responsibility:   The landing page of a documentation section that has no index file of its own: the lead of the section and the list of its pages; the command section is grouped by command group.
// Dependencies:     website.src.layouts.DocsLayout, website.src.lib.docs.model, website.src.components.content.Card

import DocsLayout from '../../layouts/DocsLayout.astro';
import CommandCatalog from '../docs/CommandCatalog.astro';
import Card from '../content/Card.astro';
import CardGrid from '../content/CardGrid.astro';
import { entryUrl, getDocs, groupDocs } from '../../lib/docs/model';
import { useUi } from '../../i18n';
import { localizedDocs } from '../../lib/docs/localized';
import type { Locale } from '../../../config/i18n';
import { href } from '../../lib/urls';

interface Props {
  section: string;
  locale?: Locale;
}

const { section, locale = 'en' } = Astro.props;
const ui = useUi(locale);
const localized = await localizedDocs(locale);
const entries = await getDocs();
const group = groupDocs(entries).find((candidate) => candidate.section === section);
if (!group) {
  throw new Error(`unknown documentation section: ${section}`);
}
const labels = ui.docs.sectionLabels as Record<string, string>;
const leads = ui.docs.sectionLeads as Record<string, string>;
const label = labels[group.labelKey] ?? section;
const lead = leads[group.labelKey] ?? '';
const commandGroups = section === 'commands';
---

<DocsLayout title={label} description={lead || label} path={`/docs/${section}/`} section={section} locale={locale} available={['en', 'pl']}>
  <p class="lead">{lead}</p>
  {commandGroups ? (
    <CommandCatalog locale={locale} />
  ) : (
    <CardGrid columns={2}>
      {group.entries.map((entry) => <Card title={localized.title(entry)} href={href(entryUrl(entry), locale)}>{localized.description(entry)}</Card>)}
    </CardGrid>
  )}
</DocsLayout>
