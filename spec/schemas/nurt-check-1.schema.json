  ],
  "description": "Result of the check without effect (`nurt-check/1`).\n\nThe check runs after binding and planning and before any execution\nstep; it neither reads nor changes the world.",
  "type": "object",
  "properties": {
    "format": {
      "description": "Format name, [`CHECK_FORMAT`].",
      "type": "string"
    },
    "effect": {
      "description": "Strongest effect of the plan.",
      "$ref": "#/$defs/EffectKind"
    },
    "reversibility": {
      "description": "Weakest reversibility of the plan.",
      "$ref": "#/$defs/Reversibility"
    },
    "operations": {
      "description": "Number of operations; more than one for a script.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "waits": {
      "description": "A stage blocks the call by waiting.",
      "type": "boolean"
    },
    "paths": {
      "description": "Paths named by literals of the program, in order of appearance.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "network": {
      "description": "Network endpoints the plan will contact.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/NetworkUse"
      }
    },
    "programs": {
      "description": "External programs the plan will start.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProgramUse"
      }
    },
    "groups": {
      "description": "Command groups the plan uses, in order of first use.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "corrections": {
      "description": "Corrections applied to the program text before binding.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Correction"
      }
    },
    "details": {
      "description": "Facts specific to commands, from their static checks.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/StageDetails"
      }
    }
  }
