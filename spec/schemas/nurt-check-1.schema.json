{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nurt.danaco-group.pl/schema/nurt-check-1.schema.json",
  "title": "nurt-check/1",
  "$defs": {
    "EffectKind": {
      "description": "Kind of effect a stage has on the world, recorded in the bound tree.",
      "oneOf": [
        {
          "description": "Reads state only; no effect outside the process.",
          "type": "string",
          "const": "read"
        },
        {
          "description": "Changes local files or content; recorded in the journal and reversible.",
          "type": "string",
          "const": "local"
        },
        {
          "description": "Has an effect outside the local file system (network, services, remote\nsystems); not reversible by the journal.",
          "type": "string",
          "const": "external"
        },
        {
          "description": "Runs a user program whose effects are detected and classified after it\nfinishes.",
          "type": "string",
          "const": "process"
        }
      ]
    },
    "Reversibility": {
      "description": "Reversibility of a command.",
      "oneOf": [
        {
          "description": "The command only reads; there is nothing to reverse.",
          "type": "string",
          "const": "read"
        },
        {
          "description": "The command is always reversible from the journal.",
          "type": "string",
          "const": "reversible"
        },
        {
          "description": "The command is reversible when the previous content was preserved;\notherwise the report marks it as irreversible.",
          "type": "string",
          "const": "reversible_if_preserved"
        },
        {
          "description": "The command is irreversible by nature.",
          "type": "string",
          "const": "irreversible"
        }
      ]
    },
    "NetworkUse": {
      "description": "Network endpoint a stage will contact.",
      "type": "object",
      "properties": {
        "command": {
          "description": "Command that contacts the endpoint.",
          "type": "string"
        },
        "param": {
          "description": "Parameter that holds the address; absent for targets reported by the\nimplementation.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "Where the target comes from.",
          "$ref": "#/$defs/TargetSource"
        },
        "target": {
          "description": "The endpoint, when known before execution.",
          "anyOf": [
            {
              "$ref": "#/$defs/NetworkTarget"
            },
            {
              "type": "null"
            }
          ]
        },
        "remote": {
          "description": "Name of the git remote, for targets resolved from the repository;\nabsent for the default remote.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "command",
        "source"
      ]
    },
    "TargetSource": {
      "description": "Where a reported target comes from.",
      "oneOf": [
        {
          "description": "A literal of the program.",
          "type": "string",
          "const": "literal"
        },
        {
          "description": "An expression evaluated per record; the target is known only while\nthe program runs.",
          "type": "string",
          "const": "record"
        },
        {
          "description": "A git remote resolved from the repository configuration while the\nprogram runs.",
          "type": "string",
          "const": "remote"
        },
        {
          "description": "The command catalog: a program the command always uses.",
          "type": "string",
          "const": "catalog"
        },
        {
          "description": "The static check of the stage implementation.",
          "type": "string",
          "const": "implementation"
        }
      ]
    },
    "NetworkTarget": {
      "description": "Network endpoint a stage will contact, reported by the static check so\nthat an embedding application can apply its own rules before execution.",
      "type": "object",
      "properties": {
        "scheme": {
          "description": "Scheme, for example `\"https\"` or `\"ssh\"`.",
          "type": "string"
        },
        "host": {
          "description": "Host name or address as written.",
          "type": "string"
        },
        "port": {
          "description": "Port, when known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "url": {
          "description": "Full address, when the stage has one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "scheme",
        "host"
      ]
    },
    "ProgramUse": {
      "description": "External program a stage will start.",
      "type": "object",
      "properties": {
        "command": {
          "description": "Command that starts the program.",
          "type": "string"
        },
        "program": {
          "description": "Program as written; absent when it is computed per record.",
          "type": [
            "string",
            "null"
          ]
        },
        "implementation": {
          "description": "Why the command uses an external program.",
          "$ref": "#/$defs/Implementation"
        },
        "launcher": {
          "description": "Program that runs the program on Windows, for batch files.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "Where the program comes from.",
          "$ref": "#/$defs/TargetSource"
        }
      },
      "required": [
        "command",
        "implementation",
        "source"
      ]
    },
    "Implementation": {
      "description": "How a command is implemented with respect to external programs.",
      "oneOf": [
        {
          "description": "Fully built into the executable.",
          "type": "string",
          "const": "builtin"
        },
        {
          "description": "Runs a program supplied by the user.",
          "type": "string",
          "const": "user_program"
        },
        {
          "description": "Acts as a client of an external language server.",
          "type": "string",
          "const": "language_server"
        },
        {
          "description": "Wraps the package manager of the operating system.",
          "type": "string",
          "const": "package_manager"
        },
        {
          "description": "Uses a component of the operating system that has no public\nprogramming interface; explicitly marked in the catalog.",
          "type": "string",
          "const": "system_program"
        }
      ]
    },
    "Correction": {
      "description": "A correction applied to the program text before it ran.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Identifier of the correction within the report, for example `C1`.",
          "type": "string"
        },
        "rule": {
          "description": "Identifier of the correction rule: a letter of the rule table\n(`L`, `T`, `V`, `B`, `P`) and two digits, for example `L01`.",
          "type": "string"
        },
        "class": {
          "description": "Certainty class of the correction.",
          "$ref": "#/$defs/CorrectionClass"
        },
        "at": {
          "description": "Position of the corrected text.",
          "anyOf": [
            {
              "$ref": "#/$defs/TextPosition"
            },
            {
              "type": "null"
            }
          ]
        },
        "from": {
          "description": "Text as written.",
          "type": "string"
        },
        "to": {
          "description": "Text after the correction.",
          "type": "string"
        },
        "kind": {
          "description": "Kind of corrected element, for example `command` or `param`.",
          "type": [
            "string",
            "null"
          ]
        },
        "alternatives": {
          "description": "Other candidates that were considered.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "rule",
        "class",
        "from",
        "to"
      ]
    },
    "CorrectionClass": {
      "description": "Certainty class of a correction of the program text.\n\n# Examples\n\n```\nuse nurt_contracts::report::CorrectionClass;\n\nassert_eq!(CorrectionClass::Fuzzy.as_str(), \"F\");\n```",
      "oneOf": [
        {
          "description": "Certain equivalence: the text differs in notation only.",
          "type": "string",
          "const": "C"
        },
        {
          "description": "Structural: a syntax character was added or removed where the\nstructure is unambiguous.",
          "type": "string",
          "const": "S"
        },
        {
          "description": "Fuzzy name: a name was matched by edit distance.",
          "type": "string",
          "const": "F"
        },
        {
          "description": "Probable: touches the bounds of a literal or resolves an ambiguity.",
          "type": "string",
          "const": "P"
        }
      ]
    },
    "TextPosition": {
      "description": "Position in the program text, counted from 1.",
      "type": "object",
      "properties": {
        "line": {
          "description": "Line number, from 1.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "column": {
          "description": "Column in Unicode scalar values, from 1.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "length": {
          "description": "Length of the corrected text in Unicode scalar values.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "line",
        "column"
      ]
    },
    "StageDetails": {
      "description": "Facts specific to one command, reported by its static check.",
      "type": "object",
      "properties": {
        "command": {
          "description": "Command.",
          "type": "string"
        },
        "index": {
          "description": "Index of the stage in its pipeline.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "details": {
          "description": "Facts by name.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          }
        }
      },
      "required": [
        "command",
        "index",
        "details"
      ]
    },
    "Value": {
      "description": "Value of the language.\n\nThe JSON form carries the type in `\"t\"` and the payload in `\"v\"` (see the\nmodule documentation).",
      "oneOf": [
        {
          "description": "Absence of a value, written `null`.",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "null"
            }
          },
          "required": [
            "t"
          ],
          "additionalProperties": false
        },
        {
          "description": "Truth value, `true` or `false`.",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "bool"
            },
            "v": {
              "type": "boolean"
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "description": "Signed 64-bit integer.",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "int"
            },
            "v": {
              "type": "integer",
              "format": "int64"
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "description": "Integer outside the 64-bit range, as decimal digits with an optional\nleading `-`; produced when reading documents.",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "big_int"
            },
            "v": {
              "type": "string"
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "description": "Finite 64-bit floating point number.",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "number"
            },
            "v": {
              "type": "number",
              "format": "double"
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "description": "Number kept as its exact source text because the binary form would\nchange it (for example `1.10` or `1e400` read from a document).",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "decimal"
            },
            "v": {
              "type": "string"
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "description": "Unicode text.",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "text"
            },
            "v": {
              "type": "string"
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "description": "Size in bytes.",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "size"
            },
            "v": {
              "$ref": "#/$defs/Size"
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "description": "Signed duration in milliseconds.",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "duration"
            },
            "v": {
              "$ref": "#/$defs/Duration"
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "description": "Point in time in UTC with nanosecond precision.",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "instant"
            },
            "v": {
              "$ref": "#/$defs/Instant"
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "description": "Date or time of day read from a document, kept in its source form.",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "date"
            },
            "v": {
              "$ref": "#/$defs/Date"
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "description": "Path in canonical form: `/` as separator, absolute, upper-case drive\nletter, or a provider path such as `env:/PATH`.",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "path"
            },
            "v": {
              "type": "string"
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "description": "File name pattern.",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "glob"
            },
            "v": {
              "type": "string"
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "description": "Regular expression.",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "regex"
            },
            "v": {
              "$ref": "#/$defs/Regex"
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "description": "Key path inside a structured document, for example `scripts.test`.",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "key"
            },
            "v": {
              "type": "string"
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "description": "Binary data.",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "bytes"
            },
            "v": {
              "$ref": "#/$defs/Bytes"
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "description": "Inclusive range of integers.",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "range"
            },
            "v": {
              "$ref": "#/$defs/Range"
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "description": "Value of an enumeration, for example `directory`.",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "enum"
            },
            "v": {
              "type": "string"
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "description": "Ordered list of values.",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "list"
            },
            "v": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Value"
              }
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "description": "Map with ordered keys.",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "map"
            },
            "v": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/Value"
              }
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        },
        {
          "description": "Record of a known kind with ordered fields.",
          "type": "object",
          "properties": {
            "t": {
              "type": "string",
              "const": "record"
            },
            "v": {
              "$ref": "#/$defs/Record"
            }
          },
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Size": {
      "description": "Size in bytes.\n\nThe text form (`12.4kb`) belongs to the language implementation; the\nJSON form is the number of bytes.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "Duration": {
      "description": "Signed duration in milliseconds.\n\nThe text form (`1h30m`) belongs to the language implementation; the JSON\nform is the number of milliseconds.",
      "type": "integer",
      "format": "int64"
    },
    "Instant": {
      "description": "Point in time in UTC, RFC 3339 with the suffix `Z`.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3}|\\.[0-9]{6}|\\.[0-9]{9})?Z$"
    },
    "Date": {
      "description": "Date or time of day as written in a structured document (TOML, YAML,\nproperty lists), kept in its source form so that writing it back does\nnot change it.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Form of the date.",
          "$ref": "#/$defs/DateKind"
        },
        "text": {
          "description": "Text exactly as in the document.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ]
    },
    "DateKind": {
      "description": "Form of a date or time read from a document.",
      "oneOf": [
        {
          "description": "Date and time with an offset, for example `2026-11-21T10:00:00+01:00`.",
          "type": "string",
          "const": "offset_date_time"
        },
        {
          "description": "Date and time without an offset, for example `2026-11-21T10:00:00`.",
          "type": "string",
          "const": "local_date_time"
        },
        {
          "description": "Date only, for example `2026-11-21`.",
          "type": "string",
          "const": "local_date"
        },
        {
          "description": "Time of day only, for example `10:00:00`.",
          "type": "string",
          "const": "local_time"
        }
      ]
    },
    "Regex": {
      "description": "Regular expression: pattern and flags.\n\nThe pattern is the source text of the expression without the enclosing\n`/` and with `\\/` already turned into `/`. The text form is\n`/pattern/flags`.\n\n```\nuse nurt_contracts::value::Regex;\n\nlet regex = Regex::new(\"a/b+\", \"i\").unwrap();\nassert_eq!(regex.to_string(), \"/a\\\\/b+/i\");\n```",
      "type": "object",
      "properties": {
        "pattern": {
          "description": "Source text of the expression.",
          "type": "string"
        },
        "flags": {
          "description": "Flags; omitted from JSON when empty.",
          "$ref": "#/$defs/RegexFlags"
        }
      },
      "additionalProperties": false,
      "required": [
        "pattern"
      ]
    },
    "RegexFlags": {
      "description": "Flag letters in the order `imsx`.",
      "type": "string",
      "pattern": "^i?m?s?x?$"
    },
    "Bytes": {
      "description": "Binary data, standard base64 with padding.",
      "type": "string",
      "contentEncoding": "base64",
      "pattern": "^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "Range": {
      "description": "Inclusive range of integers: `5`, `1..5`, `40..`, `..9`, or every\ninteger.\n\nBoth bounds are inclusive; a missing bound is open. The start is never\ngreater than the end.\n\n```\nuse nurt_contracts::value::Range;\n\nlet range = Range::new(Some(1), Some(5)).unwrap();\nassert!(range.contains(5));\nassert_eq!(range.to_string(), \"1..5\");\nassert_eq!(Range::from_start(40).to_string(), \"40..\");\nassert!(Range::new(Some(5), Some(1)).is_err());\n```",
      "type": "object",
      "properties": {
        "start": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "default": null
        },
        "end": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "Record": {
      "description": "Record: a kind and fields in a fixed order.\n\nThis is the dynamic form used by `filter`, `select`, `sort` and other\nstages that work on fields by name; the typed form of each kind is in\n[`crate::record`] and converts to and from this form.\n\n```\nuse nurt_contracts::value::{Record, RecordKind, Value};\n\nlet mut record = Record::new(RecordKind::Map).with(\"count\", Value::Int(3));\nrecord.set(\"label\", Value::from(\"done\"));\nassert_eq!(record.field_names().collect::<Vec<_>>(), [\"count\", \"label\"]);\nassert_eq!(record.get(\"count\"), Some(&Value::Int(3)));\n```",
      "type": "object",
      "properties": {
        "kind": {
          "description": "Kind of the record.",
          "$ref": "#/$defs/RecordKind"
        },
        "fields": {
          "description": "Fields in order; a field that has no value is absent.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "default": {}
        }
      },
      "additionalProperties": false,
      "required": [
        "kind"
      ]
    },
    "RecordKind": {
      "description": "Kind of a record.\n\nEvery kind has a stable name used in programs, in the catalog\n(`input` and `output` of commands) and in JSON.",
      "oneOf": [
        {
          "description": "File system entry (`list`, `find`, `info`).",
          "type": "string",
          "const": "entry"
        },
        {
          "description": "Text content of a file (`read`).",
          "type": "string",
          "const": "content"
        },
        {
          "description": "One line of a file (`lines`).",
          "type": "string",
          "const": "line"
        },
        {
          "description": "Match of a search (`search`).",
          "type": "string",
          "const": "match"
        },
        {
          "description": "Value at a key path in a structured document (`read key:`, `query`).",
          "type": "string",
          "const": "item"
        },
        {
          "description": "Row of a table, CSV file or SQLite query (`sql`, `split`).",
          "type": "string",
