{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nurt.danaco-group.pl/schema/nurt-tool-1.schema.json",
  "title": "nurt-tool/1",
  "description": "Neutral definition of the nurt tool: the tool name, the description and the input schema in a JSON Schema subset without combinators. `$defs/inputSchema` also checks the input schemas of the formats based on JSON Schema.",
  "type": "object",
  "required": ["name", "description", "input_schema"],
  "additionalProperties": false,
  "properties": {
    "name": { "const": "nurt" },
    "description": { "type": "string", "minLength": 1 },
    "input_schema": {
      "allOf": [
        { "$ref": "#/$defs/inputSchema" },
        { "required": ["$schema"], "properties": { "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" } } }
      ]
    },
    "catalog_version": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "inputSchema": {
      "allOf": [
        { "$ref": "#/$defs/schema" },
        {
          "required": ["type", "description", "properties", "additionalProperties"],
          "properties": {
            "type": { "const": "object" },
            "additionalProperties": { "const": false },
            "properties": { "required": ["program"] }
          }
        }
      ]
    },
    "schema": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "$schema",
          "type",
          "description",
          "properties",
          "required",
          "enum",
          "default",
          "items",
          "minimum",
          "maximum",
          "minLength",
          "pattern",
          "additionalProperties"
        ]
      },
      "properties": {
        "type": {
          "anyOf": [
            { "$ref": "#/$defs/typeName" },
            { "type": "array", "items": { "$ref": "#/$defs/typeName" }, "minItems": 1, "uniqueItems": true }
          ]
        },
        "description": { "type": "string" },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/schema" } },
        "required": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "enum": { "type": "array", "minItems": 1 },
        "items": { "$ref": "#/$defs/schema" },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "minLength": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string", "format": "regex" },
        "additionalProperties": { "type": "boolean" }
      }
    },
    "typeName": { "enum": ["string", "number", "integer", "boolean", "object", "array", "null"] }
  }
}
